
		<!-- 2. Premium Features Section -->
		<section class="py-20 px-4 relative overflow-hidden bg-muted/20 border-y border-border/30 cv-auto cv-intrinsic-h400">
            <div class="container mx-auto max-w-5xl text-center space-y-8">
                <div class="space-y-4">
                    <h2 class="text-3xl md:text-4xl font-extrabold tracking-tight text-foreground">Unlock more power<br/>with <span class="text-primary italic">Premium</span>.</h2>
                    <p class="text-lg text-muted-foreground max-w-2xl mx-auto leading-relaxed">
                        Remove all advertisements, sync your workspace devices, unlock advanced APIs, and access our beta utilities exclusively early.
                    </p>
                </div>
                
                <div class="grid sm:grid-cols-3 gap-6 pt-4 text-left">
                    <div class="p-6 rounded-3xl border border-border/60 bg-card hover:-translate-y-1 transition-transform shadow-sm">
                        <div class="size-10 rounded-full bg-primary/10 flex items-center justify-center text-primary mb-4">
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                        </div>
                        <h3 class="font-bold text-lg mb-2 text-foreground">Ad-Free Experience</h3>
                        <p class="text-sm text-muted-foreground">Focus entirely on your workflow. Zero distractions or banners.</p>
                    </div>
                    <div class="p-6 rounded-3xl border border-border/60 bg-card hover:-translate-y-1 transition-transform shadow-sm">
                        <div class="size-10 rounded-full bg-primary/10 flex items-center justify-center text-primary mb-4">
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/></svg>
                        </div>
                        <h3 class="font-bold text-lg mb-2 text-foreground">API Access</h3>
                        <p class="text-sm text-muted-foreground">Automate your tasks by hooking directly into our engine.</p>
                    </div>
                    <div class="p-6 rounded-3xl border border-border/60 bg-card hover:-translate-y-1 transition-transform shadow-sm">
                        <div class="size-10 rounded-full bg-primary/10 flex items-center justify-center text-primary mb-4">
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 12h-4l-3 9L9 3l-3 9H2"/></svg>
                        </div>
                        <h3 class="font-bold text-lg mb-2 text-foreground">Priority Support</h3>
                        <p class="text-sm text-muted-foreground">Skip the queue. Your feature requests get built first.</p>
                    </div>
                </div>
                <div class="pt-6">
                    <Button size="lg" href="/premium" class="px-10 rounded-full shadow-lg transition-transform hover:scale-105 group font-bold">
                        Upgrade to Premium <ArrowRight class="size-4 ml-2 transition-transform group-hover:translate-x-1" />
                    </Button>
                </div>
            </div>
        </section>

		<!-- 3/4. Split section: Buy me a Coffee & Request Feature -->
		<section class="py-20 px-4 relative overflow-hidden bg-background cv-auto cv-intrinsic-h300">
            <div class="container mx-auto max-w-5xl">
                <div class="grid md:grid-cols-2 gap-8">
                    
                    <!-- Support / Coffee -->
                    <div class="rounded-3xl border border-border/40 bg-card/60 p-8 shadow-md relative overflow-hidden group">
                        <div class="absolute right-0 top-0 w-32 h-32 bg-yellow-500/10 rounded-bl-full flex items-center justify-center transition-transform group-hover:scale-110">
                            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-yellow-500/80 -mt-8 -mr-8"><path d="M17 8h1a4 4 0 1 1 0 8h-1"/><path d="M3 8h14v9a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4Z"/><line x1="6" y1="2" x2="6" y2="4"/><line x1="10" y1="2" x2="10" y2="4"/><line x1="14" y1="2" x2="14" y2="4"/></svg>
                        </div>
                        <h3 class="text-2xl font-bold tracking-tight text-foreground mb-3">Support our work</h3>
                        <p class="text-muted-foreground mb-6 max-w-[90%] leading-relaxed">
                            We build these precision tools for free. If they've saved you time, consider fueling the developer with caffeine.
                        </p>
                        <Button variant="outline" class="border-border hover:bg-yellow-500/10 hover:text-yellow-600 hover:border-yellow-500/30 transition-colors shadow-sm font-semibold group-hover:border-border/80">
                            Buy me a coffee ☕
                        </Button>
                    </div>

                    <!-- Feature Request -->
                    <div class="rounded-3xl border border-border/40 bg-card/60 p-8 shadow-md relative overflow-hidden group">
                        <div class="absolute right-0 top-0 w-32 h-32 bg-primary/10 rounded-bl-full flex items-center justify-center transition-transform group-hover:scale-110">
                            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary/70 -mt-8 -mr-8"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
                        </div>
                        <h3 class="text-2xl font-bold tracking-tight text-foreground mb-3">Missing a tool?</h3>
                        <p class="text-muted-foreground mb-6 max-w-[90%] leading-relaxed">
                            Can't find the exact utility you need? Tell us what to build next. We actively monitor community requests.
                        </p>
                        <!-- Using the provided dialog component -->
                        <FeatureRequestDialog client:idle class="bg-primary text-primary-foreground hover:bg-primary/90 transition-transform shadow-sm font-semibold hover:scale-[1.02]" />
                    </div>

                </div>
            </div>
        </section>
