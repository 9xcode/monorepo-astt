## Usage in Astro

import EyeButton from '../components/EyeButton.svelte';


<EyeButton client:idle />

  // button with custom colors
  <EyeButton 
    client:idle 
    buttonColor="bg-zinc-900" 
    textColor="text-white"
    pupilColor="bg-yellow-400"
    text="Sponsor Project"
    eyeSize={28}
    pupilSize={12}
  />