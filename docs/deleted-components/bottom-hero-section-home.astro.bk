
		<!-- Feature Highlight — below the fold; native optimization via content-visibility -->
		<section class="py-24 px-4 relative overflow-hidden bg-background cv-auto cv-intrinsic-h700">
            <div class="absolute -right-1/4 top-1/2 -translate-y-1/2 w-[800px] h-[800px] bg-primary/10 rounded-full blur-3xl opacity-50 -z-10 pointer-events-none"></div>
			<div class="container mx-auto grid lg:grid-cols-2 gap-16 items-center">
				<div class="space-y-8">
                    <div class="inline-flex items-center rounded-full border border-border/60 px-3 py-1 text-xs font-bold bg-muted/50 text-muted-foreground uppercase tracking-widest">Built for Speed</div>
					<h2 class="text-4xl md:text-5xl font-extrabold tracking-tight">Tools for every professional.</h2>
					<p class="text-xl text-muted-foreground leading-relaxed">
						Whether you're calculating complex loan amortizations, compressing base64 strings, or tracking a budget, {siteConfig.name} offers a beautifully crafted, distraction-free environment.
					</p>
					<ul class="space-y-6 text-lg pt-4">
						<li class="flex items-start gap-4">
							<div class="size-10 shrink-0 rounded-xl bg-primary/10 flex items-center justify-center text-primary font-bold shadow-inner">1</div>
							<div class="space-y-1">
                                <span class="font-semibold block text-foreground">Instant, local calculations</span>
                                <span class="text-sm text-muted-foreground block">Powered by Svelte 5 logic running right in your browser.</span>
                            </div>
						</li>
						<li class="flex items-start gap-4">
							<div class="size-10 shrink-0 rounded-xl bg-primary/10 flex items-center justify-center text-primary font-bold shadow-inner border border-primary/10">2</div>
							<div class="space-y-1">
                                <span class="font-semibold block text-foreground">Zero loading screens</span>
                                <span class="text-sm text-muted-foreground block">Switch between tools instantly. We value your time.</span>
                            </div>
						</li>
						<li class="flex items-start gap-4">
							<div class="size-10 shrink-0 rounded-xl bg-primary/10 flex items-center justify-center text-primary font-bold shadow-inner">3</div>
							<div class="space-y-1">
                                <span class="font-semibold block text-foreground">100% private data</span>
                                <span class="text-sm text-muted-foreground block">Every keystroke stays on your device. Zero analytics.</span>
                            </div>
						</li>
					</ul>
					<div class="flex flex-col sm:flex-row items-center gap-4 pt-8">
                        <Button 
                            size="lg" 
                            href="/get-app" 
                            class="w-full sm:w-auto px-8 bg-primary hover:bg-primary/90 text-primary-foreground shadow-md transition-shadow hover:shadow-lg"
                        > 
                            <Download class="size-4 mr-2" /> Download App
                        </Button>

                        <FeatureRequestDialog client:idle class="w-full sm:w-auto px-8 border-border bg-muted/30 hover:bg-muted text-foreground shadow-sm hover:shadow" />
                    </div>
				</div>

				<div class="relative group mx-auto w-full max-w-md lg:ml-auto">
                    <div class="absolute inset-0 bg-gradient-to-tr from-primary/30 via-primary/5 to-transparent blur-3xl rounded-[3rem] transform group-hover:scale-105 transition-transform duration-700"></div>
					<div class="relative rounded-[2.5rem] border border-border/60 bg-card p-2 md:p-3 shadow-2xl overflow-hidden ring-1 ring-border/30">
                        <div class="rounded-[2rem] bg-background border border-border/40 overflow-hidden">
                            <!-- Pseudo app window mockup -->
                            <div class="flex items-center gap-2 px-6 py-4 bg-muted/40 border-b border-border/40">
                                <div class="size-3.5 rounded-full bg-red-400/80 shadow-sm"></div>
                                <div class="size-3.5 rounded-full bg-yellow-400/80 shadow-sm"></div>
                                <div class="size-3.5 rounded-full bg-green-400/80 shadow-sm"></div>
                                <div class="flex-1 text-center pr-10">
                                    <span class="text-xs font-medium text-muted-foreground px-4 py-1.5 bg-background rounded-md shadow-sm border border-border/50">{siteConfig.domain}</span>
                                </div>
                            </div>
                            <div class="p-6 space-y-6 bg-gradient-to-b from-muted/20 to-background min-h-[400px]">
                                <div class="flex items-center justify-between">
                                    <div class="space-y-3 w-1/2">
                                        <div class="h-5 bg-muted-foreground/20 rounded-full w-full"></div>
                                        <div class="h-4 bg-muted-foreground/10 rounded-full w-3/4"></div>
                                    </div>
                                    <div class="size-12 rounded-xl bg-primary/20 shadow-inner flex items-center justify-center">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-6 text-primary"><path d="M12 2v20"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
                                    </div>
                                </div>
                                <div class="grid grid-cols-2 gap-4 pt-4">
                                    <div class="h-28 bg-card border rounded-2xl shadow-sm hover:border-primary/50 transition-colors p-4 space-y-2">
                                        <div class="size-8 bg-muted rounded-lg"></div>
                                        <div class="h-3 bg-muted-foreground/20 rounded-full w-2/3"></div>
                                        <div class="h-2 bg-muted-foreground/10 rounded-full w-1/2"></div>
                                    </div>
                                    <div class="h-28 bg-card border rounded-2xl shadow-sm hover:border-primary/50 transition-colors p-4 space-y-2">
                                        <div class="size-8 bg-muted rounded-lg"></div>
                                        <div class="h-3 bg-muted-foreground/20 rounded-full w-3/4"></div>
                                        <div class="h-2 bg-muted-foreground/10 rounded-full w-1/3"></div>
                                    </div>
                                    <div class="h-28 bg-card border rounded-2xl shadow-sm hover:border-primary/50 transition-colors p-4 space-y-2">
                                        <div class="size-8 bg-muted rounded-lg"></div>
                                        <div class="h-3 bg-muted-foreground/20 rounded-full w-1/2"></div>
                                        <div class="h-2 bg-muted-foreground/10 rounded-full w-2/3"></div>
                                    </div>
                                    <div class="h-28 bg-primary/5 border border-primary/20 rounded-2xl shadow-sm relative overflow-hidden flex flex-col items-center justify-center group-hover:bg-primary/10 transition-colors cursor-pointer">
                                        <div class="text-primary font-medium text-sm">View More</div>
                                        <ArrowRight class="size-4 text-primary mt-1" />
                                    </div>
                                </div>
                            </div>
                        </div>
					</div>
				</div>
			</div>
		</section>
