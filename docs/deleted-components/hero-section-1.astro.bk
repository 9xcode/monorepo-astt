                        <span class="font-bold text-foreground ml-1">5.0</span>
                    </div>
                    <div class="hidden md:block h-4 w-px bg-border"></div>
                    <span>Loved by professionals &amp; developers</span>
                </div>

                <!-- CTA -->
                <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
                    <a href="#tools-section" class="inline-flex h-11 items-center justify-center rounded-md bg-foreground px-8 text-sm font-medium text-background shadow transition-colors hover:bg-foreground/90 w-full sm:w-auto">
                        Get all access ❇
                    </a>
                    <button onclick="window.dispatchEvent(new CustomEvent('open-search'))" class="inline-flex h-11 items-center justify-center rounded-md bg-secondary px-8 text-sm font-medium text-secondary-foreground shadow-sm transition-colors hover:bg-secondary/80 w-full sm:w-auto">
                        Explore more →
                    </button>
                </div>
			</div>
		</section>