<!-- Hero Section -->
		<section class="relative pt-20 pb-28 md:pt-32 md:pb-36 px-4 text-center overflow-hidden">
            <!-- Box Grid Background with Fade -->
            <div class="absolute inset-0 -z-20 h-full w-full bg-background bg-[linear-gradient(to_right,#8080801a_1px,transparent_1px),linear-gradient(to_bottom,#8080801a_1px,transparent_1px)] bg-[size:40px_40px] [mask-image:radial-gradient(ellipse_60%_60%_at_50%_0%,#000_70%,transparent_100%)]"></div>
            <!-- Subtle top glow -->
            <div class="absolute top-0 left-1/2 w-full -translate-x-1/2 -z-10 h-64 bg-primary/5 blur-[100px] rounded-full pointer-events-none"></div>

			<div class="container mx-auto max-w-4xl relative z-10 antialiased pt-4">
                <!-- Top Badge -->
                <div class="mx-auto w-fit mb-8">
                    <span class="inline-flex items-center rounded-full border border-border bg-background px-3 py-1.5 text-sm text-muted-foreground shadow-sm cursor-default hover:bg-muted/50 transition-colors">
                        <span class="mr-2 inline-flex items-center rounded-full bg-foreground px-2 py-0.5 text-[10px] font-bold text-background uppercase tracking-wider">New</span>
                        🎉 Explore 50+ Web Tools &amp; Utilities 🪄
                    </span>
                </div>

                <!-- Title -->
                <h1 class="text-4xl md:text-5xl lg:text-7xl font-bold tracking-tight text-foreground leading-[1.1] mb-6">
                    Solve Everyday Tasks <br class="hidden md:block"/>
                    at <span class="bg-gradient-to-br from-foreground to-muted-foreground bg-clip-text text-transparent italic pr-2">Warp Speed</span> ⚡
                </h1>

                <!-- Subtitle -->
                <p class="text-lg md:text-xl text-muted-foreground max-w-2xl mx-auto leading-relaxed mb-10">
                    Accelerate your projects with ready-to-use, fully customizable web tools. 
                    <strong class="font-medium text-foreground">Calculators, Converters, Formatters, &amp; Scripts</strong> 🪄.
                </p>

                <!-- Social Proof / Rating -->
                <div class="flex flex-col md:flex-row items-center justify-center gap-4 md:gap-6 mb-10 text-sm text-muted-foreground">
                    <div class="flex items-center gap-1">
                        <svg xmlns="http://www.w3.org/2000/svg" class="size-5 text-amber-500" viewBox="0 0 20 20" fill="currentColor"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
