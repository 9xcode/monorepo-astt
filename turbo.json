{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".astro/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "preview": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "check": {
      "dependsOn": ["^build"]
    },
    "check:astro": {
      "dependsOn": ["^build"]
    },
    "check:svelte": {
      "dependsOn": ["^build"]
    },
    "check:tsc": {
      "dependsOn": ["^build"]
    }
  }
}
