{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".astro/**"],
      "inputs": ["src/**", "public/**", "astro.config.*", "package.json"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "check": {
      "dependsOn": ["^build"]
    },
    "check:astro": {
      "dependsOn": ["^build"]
    },
    "check:svelte": {
      "dependsOn": ["^build"]
    },
    "check:tsc": {
      "dependsOn": ["^build"]
    }
  }
}
