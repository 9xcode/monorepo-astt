{
  "name": "@mtools/SITE_NAME",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=20",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "generate-widget-map && astro dev",
    "build": "generate-widget-map && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "check:astro": "astro check",
    "check:svelte": "svelte-check --tsconfig ./tsconfig.json",
    "check:tsc": "tsc --noEmit",
    "lint": "eslint .",
