{
  "name": "@mtools/SITE_NAME",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=20",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "generate-widget-map && astro dev",
    "build": "generate-widget-map && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check && svelte-check --tsconfig ./tsconfig.json && tsc --noEmit",
    "check:astro": "astro check",
    "check:svelte": "svelte-check --tsconfig ./tsconfig.json",
    "check:tsc": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "validate": "eslint . && astro check && svelte-check --tsconfig ./tsconfig.json && tsc --noEmit && astro build"
  },
  "dependencies": {
    "@mtools/core": "workspace:*",
    "astro": "catalog:",
    "@astrojs/svelte": "catalog:",
    "@astrojs/sitemap": "catalog:",
    "svelte": "catalog:",
    "@lucide/svelte": "catalog:",
    "bits-ui": "catalog:",
    "clsx": "catalog:",
    "tailwind-merge": "catalog:"
  },
  "devDependencies": {
    "@astrojs/check": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "rehype-katex": "catalog:",
    "remark-math": "catalog:",
    "svelte-check": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:"
  }
}
