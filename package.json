{
  "name": "monorepo-astt",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "turbo dev",
    "dev:finance": "turbo dev --filter=@mtools/finance-tools",
    "dev:qrcode": "turbo dev --filter=@mtools/onlineqrcodescanner-com",

    "build": "turbo build",
    "build:finance": "turbo build --filter=@mtools/finance-tools",
    "build:qrcode": "turbo build --filter=@mtools/onlineqrcodescanner-com",

    "preview": "turbo preview",
    "preview:finance": "turbo preview --filter=@mtools/finance-tools",
    "preview:qrcode": "turbo preview --filter=@mtools/onlineqrcodescanner-com",

    "check": "turbo check:astro check:svelte check:tsc",
    "check:core": "turbo check --filter=@mtools/core",
    "check:finance": "turbo check --filter=@mtools/finance-tools",
    "check:astro": "turbo check:astro",
    "check:svelte": "turbo check:svelte",
    "check:tsc": "turbo check:tsc",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "validate": "eslint . && echo '─── CHECKS ───' && turbo check:astro check:svelte check:tsc && echo '─── BUILD ───' && turbo build",
    
    "preinstall": "npx only-allow pnpm",
    "nuke": "./scripts/nuke.sh",
    "reinstall": "./scripts/nuke.sh && pnpm install"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "eslint": "^10.2.0",
    "turbo": "^2.9.9",
    "sharp": "^0.34.5",
    "astro-eslint-parser": "^1.4.0",
    "eslint-plugin-astro": "^1.7.0",
    "eslint-plugin-svelte": "^3.17.0",
    "svelte-eslint-parser": "^1.6.0",
    "@typescript-eslint/parser": "^8.58.1",
    "@typescript-eslint/eslint-plugin": "^8.58.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild", "sharp"]
  },
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@10.33.2+sha512.a90faf6feeab71ad6c6e57f94e0fe1a12f5dcc22cd754db40ae9593eb6a3e0b6b12e3540218bb37ae083404b1f2ce6db2a4121e979829b4aff94b99f49da1cf8"
}
