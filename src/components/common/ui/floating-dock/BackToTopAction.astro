---
import { ChevronUp } from '@lucide/svelte';
---
{/*
  BackToTopAction — Pill button: icon-circle with hover expand label.
  Sizing matches the toggle button (size-11 circle).
*/}
<button
  class="dock-action-btn group"
  aria-label="Scroll to top"
  onclick="window.scrollTo({ top: 0, behavior: 'smooth' })"
>
  <span class="dock-label whitespace-nowrap text-sm font-medium">
    Scroll to Top
  </span>
  <span class="dock-icon-wrap">
    <ChevronUp class="size-[1.125rem]" aria-hidden="true" />
  </span>
</button>
