---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"div"> {
  class?: string;
}
const { class: className = "", ...rest } = Astro.props;
---

<div 
  class={`prose prose-slate dark:prose-invert max-w-none prose-headings:scroll-mt-24 ${className} rich-article`}
  {...rest}
>
  <slot />
</div>

<style is:global>
  /* Ported from article.css.tmp - Highly customized typography styles */
  .rich-article {
    font-size: 0.9375rem;  /* 15px — comfortable article body */
    line-height: 1.8;
  }

  /* ------- HEADINGS ------- */
  .rich-article h2, .rich-article h3, .rich-article h4, .rich-article h5 {
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.3;
  }
  .rich-article h2 {
    font-size: 1.35rem;
    margin-top: 2.5rem;
    margin-bottom: 0.75rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid color-mix(in oklch, var(--border) 60%, transparent);
  }
  .rich-article h3 {
    font-size: 1.1rem;
    margin-top: 2rem;
    margin-bottom: 0.5rem;
  }
  .rich-article h4 {
    font-size: 0.95rem;
    margin-top: 1.5rem;
    margin-bottom: 0.4rem;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    color: var(--muted-foreground);
  }

  /* ------- PARAGRAPHS ------- */
  .rich-article p { margin-bottom: 1.1rem; }

  /* ------- INLINE CODE ------- */
  .rich-article :not(pre) > code {
    font-size: 0.8em;
    font-weight: 500;
    background-color: var(--muted);
    border: 1px solid var(--border);
    border-radius: 0.3em;
    padding: 0.15em 0.45em;
    white-space: nowrap;
  }

  /* ------- CODE BLOCKS ------- */
  .rich-article pre {
    background-color: oklch(0.208 0.042 265.755); /* Dark background override mapping */
    border: 1px solid color-mix(in oklch, var(--border) 40%, transparent);
    border-radius: 0.75rem;
    padding: 1.25rem 1.5rem;
    overflow-x: auto;
    margin: 1.5rem 0;
    scrollbar-width: thin;
    scrollbar-color: color-mix(in oklch, var(--muted-foreground) 40%, transparent) transparent;
  }
  .rich-article pre code {
    font-size: 0.84em;
    color: oklch(0.85 0.02 240);
    background: none;
    border: none;
    padding: 0;
    white-space: pre;
  }

  /* ------- BLOCKQUOTE ------- */
  .rich-article blockquote {
    border-left: 3px solid var(--primary);
    background-color: color-mix(in oklch, var(--muted) 40%, transparent);
    border-radius: 0 0.5rem 0.5rem 0;
    padding: 0.85rem 1.25rem;
    margin: 1.5rem 0;
    font-style: normal;
  }
  .rich-article blockquote p { margin: 0; color: var(--muted-foreground); }

  /* ------- LINKS ------- */
  .rich-article a {
    text-decoration: none;
    font-weight: 500;
    transition: opacity 0.15s;
  }
  .rich-article a:hover { text-decoration: underline; opacity: 0.85; }

  /* Internal tool links — styled as a chip */
  .rich-article a[href^="/tools/"] {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    font-size: 0.875em;
    font-weight: 600;
    background-color: color-mix(in oklch, var(--primary) 8%, transparent);
    border: 1px solid color-mix(in oklch, var(--primary) 25%, transparent);
    border-radius: 999px;
    padding: 0.2em 0.75em 0.2em 0.6em;
    text-decoration: none !important;
    white-space: nowrap;
    transition: background-color 0.15s, border-color 0.15s;
  }
  .rich-article a[href^="/tools/"]::after {
    content: "→ Try tool";
    font-size: 0.85em;
    font-weight: 400;
    opacity: 0.65;
  }
  .rich-article a[href^="/tools/"]:hover {
    background-color: color-mix(in oklch, var(--primary) 15%, transparent);
    border-color: color-mix(in oklch, var(--primary) 50%, transparent);
    text-decoration: none;
  }

  /* ------- LISTS ------- */
  .rich-article ul { list-style: none; padding-left: 0.25rem; }
  .rich-article ul li {
    position: relative;
    padding-left: 1.5rem;
    margin-bottom: 0.35rem;
  }
  .rich-article ul li::before {
    content: "•";
    position: absolute;
    left: 0.2rem;
    color: var(--primary);
    font-weight: 700;
  }
  .rich-article ol { padding-left: 1.75rem; }
  .rich-article ol li {
    padding-left: 0.4rem;
    margin-bottom: 0.35rem;
  }
  .rich-article ol li::marker { color: var(--primary); font-weight: 700; }

  /* ------- TASK LISTS (GitHub checkbox syntax) ------- */
  .rich-article ul li:has(> input[type="checkbox"]) {
    padding-left: 1.75rem;
  }
  .rich-article ul li:has(> input[type="checkbox"])::before { display: none; }
  .rich-article ul li > input[type="checkbox"] {
    position: absolute;
    left: 0;
    top: 0.2em;
    accent-color: var(--primary);
    width: 1em;
    height: 1em;
    cursor: default;
  }

  /* ------- TABLES ------- */
  .rich-article table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.875em;
    margin: 1.5rem 0;
    border-radius: 0.75rem;
    overflow: hidden;
    border: 1px solid var(--border);
  }
  .rich-article thead {
    background-color: var(--muted);
  }
  .rich-article thead th {
    font-weight: 700;
    font-size: 0.8em;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    padding: 0.7rem 1rem;
    text-align: left;
    border-bottom: 1px solid var(--border);
  }
  .rich-article tbody tr:nth-child(even) { background-color: color-mix(in oklch, var(--muted) 35%, transparent); }
  .rich-article tbody td {
    padding: 0.6rem 1rem;
    border-bottom: 1px solid color-mix(in oklch, var(--border) 50%, transparent);
    color: var(--muted-foreground);
  }
  .rich-article tbody tr:last-child td { border-bottom: none; }

  /* ------- HORIZONTAL RULE ------- */
  .rich-article hr {
    border: none;
    border-top: 1px solid color-mix(in oklch, var(--border) 60%, transparent);
    margin: 2rem 0;
  }

  /* ------- STRONG & EM ------- */
  .rich-article strong { font-weight: 700; }
  .rich-article em { font-style: italic; }

  /* ------- FOOTNOTES ------- */
  .rich-article .footnotes {
    margin-top: 2.5rem;
    padding-top: 1rem;
    border-top: 1px solid color-mix(in oklch, var(--border) 50%, transparent);
    font-size: 0.8em;
    color: var(--muted-foreground);
  }
  .rich-article sup a {
    font-size: 0.75em;
    font-weight: 600;
    text-decoration: none;
    padding: 0 0.15em;
  }

  /* ------- IMAGES ------- */
  .rich-article img {
    border-radius: 0.75rem;
    border: 1px solid color-mix(in oklch, var(--border) 50%, transparent);
    max-width: 100%;
  }
</style>
