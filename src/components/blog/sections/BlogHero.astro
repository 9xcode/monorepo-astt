---
/**
 * BlogHero — Post header with title, metadata, and optional cover image.
 * Renders the H1, author byline, dates, read time, category badge, and
 * an optional cover image with eager loading to prevent CLS.
 */
import { formatW3CDate } from '@mtools/core/utils/w3c-date';
import Breadcrumb from '../../common/ui/Breadcrumb.astro';
import type { AuthorEntry } from '../../../utils/authors';
import AuthorByline from '../../authors/AuthorByline.astro';

interface Props {
  title: string;
  lastModified?: string | Date;
  authors: AuthorEntry[];
  coverImage?: string;
  coverImageAlt?: string;
  readTime: number;
  category: string;
  categorySlug: string;
}

const { title, lastModified, authors, coverImage, coverImageAlt, readTime, category, categorySlug } = Astro.props;
const resolvedModDate = lastModified ? new Date(formatW3CDate(lastModified)) : null;
---

<header class="mb-2 lg:mb-4">
  <div class="mb-6 flex flex-wrap items-center justify-between gap-4">
    <Breadcrumb items={[
      { label: "Home", href: "/" },
      { label: "Blog", href: "/blog" },
      { label: category, href: `/blog/category/${categorySlug}` },
      { label: title },
    ]} />
  </div>

  <h1 class="text-2xl sm:text-3xl lg:text-4xl font-black tracking-tight text-foreground mb-5 leading-[1.15] text-balance">
    {title}
  </h1>

  <div class="flex flex-wrap items-center gap-x-4 gap-y-3 text-sm text-muted-foreground">
    <div class="flex items-center gap-2">
      <AuthorByline authors={authors} showAvatar={true} linkToProfile />
    </div>
    
    <span class="text-border/80 hidden sm:inline" aria-hidden="true">•</span>

    <a 
      href={`/blog/category/${categorySlug}`} 
      class="font-medium text-foreground hover:text-primary transition-colors flex items-center gap-1.5"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary/70"><path d="M4 20h16a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.93a2 2 0 0 1-1.66-.9l-.82-1.2A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13c0 1.1.9 2 2 2Z"/></svg>
      {category}
    </a>
    
    {resolvedModDate && (
      <>
        <span class="text-border/80 hidden sm:inline" aria-hidden="true">•</span>
        <time datetime={formatW3CDate(lastModified)} class="font-medium flex items-center gap-1.5" title="Last updated">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary/70"><path d="M21 12a9 9 0 0 0-9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/><path d="M3 12a9 9 0 0 0 9 9 9.75 9.75 0 0 0 6.74-2.74L21 16"/><path d="M16 21v-5h5"/></svg>
          {resolvedModDate.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}
        </time>
      </>
    )}
    
    <span class="text-border/80 hidden sm:inline" aria-hidden="true">•</span>
    <span class="font-medium flex items-center gap-1.5">
      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary/70"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
      {readTime} min read
    </span>
  </div>

  {coverImage && (
    <div class="relative rounded-xl md:rounded-2xl overflow-hidden border border-border/20 bg-muted/20 shadow-sm mt-8">
      <img
        src={coverImage}
        alt={coverImageAlt ?? title}
        loading="eager"
        decoding="async"
        width="1200"
        height="630"
        class="w-full aspect-video md:aspect-[2/1] object-cover hover:scale-[1.01] transition-transform duration-700 ease-in-out"
      />
    </div>
  )}
</header>
