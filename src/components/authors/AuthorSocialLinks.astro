---
/**
 * AuthorSocialLinks — Social icon link bar for an author.
 *
 * Shared by AuthorCard and AuthorProfileHero to eliminate duplicated inline SVGs.
 * Renders only the social slots that have non-empty URLs.
 *
 * Usage:
 *   <AuthorSocialLinks socials={author.data.socials} name={author.data.name} size="md" />
 */

import { siteConfig } from '../../config';

interface Socials {
  twitter:  string;
  linkedin: string;
  github:   string;
  facebook: string;
}

interface Props {
  socials: Socials;
  name: string;
  /** 'sm' → size-6 icons (AuthorCard), 'md' → size-9 icons (ProfileHero). Default: 'sm'. */
  size?: 'sm' | 'md';
  /** Extra classes on the container flex div. */
  class?: string;
  /** Optional profile URL to render the profile link button before the support button. */
  profileUrl?: string;
}

const { socials, name, size = 'sm', class: className, profileUrl } = Astro.props;

const buttonCls = size === 'md'
  ? 'size-9 rounded-lg bg-secondary/60 flex items-center justify-center text-muted-foreground hover:text-foreground hover:bg-secondary transition-colors'
  : 'size-6 sm:size-8 rounded-md bg-secondary/50 flex items-center justify-center text-muted-foreground hover:text-foreground hover:bg-secondary transition-colors';

const iconCls = size === 'md' ? 'size-4' : 'size-3 sm:size-4';

const links = [
  {
    href: socials.twitter,
    label: `${name} on X (Twitter)`,
    svg: `<svg class="${iconCls}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4l11.733 16h4.267l-11.733 -16z" /><path d="M4 20l6.768 -6.768m2.46 -2.46l6.772 -6.772" /></svg>`,
  },
  {
    href: socials.linkedin,
    label: `${name} on LinkedIn`,
    svg: `<svg class="${iconCls}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path><rect x="2" y="9" width="4" height="12"></rect><circle cx="4" cy="4" r="2"></circle></svg>`,
  },
  {
    href: socials.github,
    label: `${name} on GitHub`,
    svg: `<svg class="${iconCls}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path></svg>`,
  },
  {
    href: socials.facebook,
    label: `${name} on Facebook`,
    svg: `<svg class="${iconCls}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path></svg>`,
  }
] as const;
---

<div class:list={['flex items-center gap-1.5 sm:gap-2 flex-wrap', className]}>
  {links.map(({ href, label, svg }) =>
    href && (
      <a
        href={href}
        target="_blank"
        rel="noopener noreferrer"
        class={buttonCls}
        aria-label={label}
        set:html={svg}
      />
    )
  )}

  {profileUrl && (
    <a
      href={profileUrl}
      class={buttonCls}
      aria-label={`View ${name}'s full profile`}
    >
      <svg class={iconCls} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path>
        <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path>
      </svg>
    </a>
  )}

  {siteConfig.features?.support?.url && (
    <a
      href={siteConfig.features.support.url}
      target="_blank"
      rel="noopener noreferrer"
      class={buttonCls}
      aria-label={siteConfig.features.support.label || 'Support us'}
    >
      <svg class={iconCls} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M17 8h1a4 4 0 1 1 0 8h-1"/><path d="M3 8h14v9a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4Z"/><line x1="6" x2="6" y1="2" y2="4"/><line x1="10" x2="10" y1="2" y2="4"/><line x1="14" x2="14" y1="2" y2="4"/>
      </svg>
    </a>
  )}
</div>
