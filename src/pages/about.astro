---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/common/sections/Header.astro";
import Footer from "../components/common/sections/Footer.astro";
import StandardProse from "../components/common/typography/StandardProse.astro";
import { siteConfig } from "../config";
import JsonLd from "../components/common/seo/JsonLd.astro";
import { buildWebPageSchema } from "../components/common/seo";

const seoUrl = new URL('/about', siteConfig.url).href;

const aboutSchema = buildWebPageSchema({
	type: 'AboutPage',
	name: `About Us - ${siteConfig.name}`,
	description: `Learn more about ${siteConfig.name}, our mission, and our commitment to privacy and providing top-tier free tools and calculators for everyone.`,
	url: seoUrl,
});
---
<BaseLayout title={`About Us - ${siteConfig.name}`} canonicalURL={seoUrl} description={`Learn more about ${siteConfig.name}, our mission, and our commitment to privacy and providing top-tier free tools and calculators for everyone.`}>
	<Fragment slot="head">
		<JsonLd schema={aboutSchema} />
	</Fragment>
	<Header />
	<main class="flex-1 container mx-auto px-4 py-16 max-w-4xl">
		<StandardProse>
			<h1>About {siteConfig.name}</h1>
			
			<p class="lead">At {siteConfig.name}, we believe that premium quality software should be free, fast, and entirely private.</p>
			
			<h2>Our Mission</h2>
			<p>We started {siteConfig.name} because we were tired of online calculators that were bloated with tracking scripts, slow loading times, and invasive ads. Our mission is to provide the internet's best collection of daily utility tools and financial calculators in a completely frictionless environment.</p>
			
			<h2>Why Choose Us?</h2>
			<ul>
				<li><strong>Absolute Privacy:</strong> Every calculation you perform on our site runs entirely in your local browser. We do not transmit, save, or harvest your personal financial figures or text inputs.</li>
				<li><strong>Blazing Fast:</strong> By utilizing modern web frameworks like Astro and Svelte, our tools load instantly. There are no loading spinners or waiting times.</li>
				<li><strong>100% Free:</strong> We do not hide our advanced features behind paywalls or subscriptions. Our entire toolkit is available to you forever.</li>
			</ul>

			<h2>Who We Are</h2>
			<p>We are a small team of independent software engineers and designers passionate about creating beautiful, functional micro-applications. We actively listen to user feedback and constantly deploy new calculators based on what our community needs most.</p>
			
			<h2>Get in Touch</h2>
			<p>We love hearing from our users! Whether you want to request a new feature, report a bug, or just say hello, please feel free to reach out to us via our <a href="/contact">Contact Page</a>.</p>
		</StandardProse>
	</main>
	<Footer />
</BaseLayout>
