    "build": "echo '@mtools/core has no compiled output — type-checked via sites'",
    "check": "astro check && svelte-check --tsconfig ./tsconfig.json && tsc --noEmit",
    "check:astro": "astro check",
    "check:svelte": "svelte-check --tsconfig ./tsconfig.json",
    "check:tsc": "tsc --noEmit"
