    "./content-schemas/authors": "./src/content-schemas/authors.ts",
    "./middleware/config-injector": "./src/middleware/config-injector.ts",
    "./integrations/core-pages": "./integrations/core-pages.ts",
    "./integrations/og-cache": "./integrations/og-cache/index.ts",
    "./utils/slug": "./src/utils/slug.ts",
    "./utils/prng": "./src/utils/prng.ts",
