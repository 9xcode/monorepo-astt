---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/common/sections/Header.astro";
import Footer from "../components/common/sections/Footer.astro";
import StandardProse from "../components/common/typography/StandardProse.astro";
import { siteConfig } from 'virtual:site-config';
import JsonLd from "../seo/JsonLd.astro";
import { buildWebPageSchema } from "../seo";

const seoUrl = new URL(Astro.url.pathname, siteConfig.url).href;
const pageTitle = `Terms & Conditions - ${siteConfig.name}`;
const pageDescription = `Terms and conditions for using ${siteConfig.name}.`;
const pageSchema = buildWebPageSchema({
	type: 'WebPage',
	name: pageTitle,
	description: pageDescription,
	url: seoUrl,
	websiteUrl: siteConfig.url,
});
---
<BaseLayout title={pageTitle} canonicalURL={seoUrl} description={pageDescription}>
	<Fragment slot="head">
		<JsonLd schema={pageSchema} />
	</Fragment>
	<Header />
	<main class="flex-1 container mx-auto px-4 py-16 max-w-4xl">
		<StandardProse>
			<h1>Terms & Conditions</h1>
			<p class="lead">Last updated: {new Date(siteConfig.buildTime).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</p>
			
			<h2>1. Acceptance of Terms</h2>
			<p>By accessing and using {siteConfig.name}, you agree to be bound by these Terms and Conditions. If you disagree with any part of these terms, please do not use our website.</p>
			
			<h2>2. Disclaimer of Warranties</h2>
			<p>The calculators and tools provided on this website are for educational and informational purposes only. While we strive for accuracy, we make no guarantees regarding the exactness of the results. You should not make financial decisions based solely on our calculators without consulting a qualified financial advisor.</p>
			
			<h2>3. Use License</h2>
			<p>Permission is granted to use our web-based tools and download our mobile app for personal, non-commercial use. You may not attempt to reverse engineer any software contained on the website without explicit permission.</p>
			
			<h2>4. Modifications</h2>
			<p>We may revise these terms of service at any time without notice. By using this website, you are agreeing to be bound by the then-current version of these Terms of Service.</p>
		</StandardProse>
	</main>
	<Footer />
</BaseLayout>
