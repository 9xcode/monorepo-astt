---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/common/sections/Header.astro";
import Footer from "../components/common/sections/Footer.astro";
import StandardProse from "../components/common/typography/StandardProse.astro";
import { siteConfig } from 'virtual:site-config';
import JsonLd from "../seo/JsonLd.astro";
import { buildWebPageSchema } from "../seo";

const seoUrl = new URL(Astro.url.pathname, siteConfig.url).href;
const pageTitle = `Privacy Policy - ${siteConfig.name}`;
const pageDescription = `Privacy Policy for ${siteConfig.name}. We believe in absolute privacy.`;
const pageSchema = buildWebPageSchema({
	type: 'WebPage',
	name: pageTitle,
	description: pageDescription,
	url: seoUrl,
	websiteUrl: siteConfig.url,
});
---
<BaseLayout title={pageTitle} canonicalURL={seoUrl} description={pageDescription}>
	<Fragment slot="head">
		<JsonLd schema={pageSchema} />
	</Fragment>
	<Header />
	<main class="flex-1 container mx-auto px-4 py-16 max-w-4xl">
		<StandardProse>
			<h1>Privacy Policy</h1>
			<p class="lead">Last updated: {new Date(siteConfig.buildTime).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</p>
			
			<p>At {siteConfig.name}, we built our platform with a fundamental belief: <strong>your data is yours, and we do not want it.</strong></p>
			
			<h2>1. Zero Tracking Policy</h2>
			<p>We do not use any analytics trackers, pixels, cookies, or third-party monitoring tools capable of identifying you or tracking your usage behavior.</p>
			
			<h2>2. Local Computations</h2>
			<p>Every tool, calculator, and converter on {siteConfig.name} runs entirely client-side (in your browser). We do not send the data you input to our servers. Any financial or personal data you calculate stays on your device.</p>
			
			<h2>3. App Privacy</h2>
			<p>Our mobile app conforms to the same strict zero-tracking standards as our website. It requests no intrusive permissions and stores everything locally.</p>
			
			<h2>4. Contact Us</h2>
			<p>If you have any questions about our privacy practices, you can contact us via our <a href="/contact">Contact Page</a>.</p>
		</StandardProse>
	</main>
	<Footer />
</BaseLayout>
