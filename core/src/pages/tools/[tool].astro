---
import { render } from 'astro:content';
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import { siteConfig } from 'virtual:site-config';
import { parseFaqSchema, parseHowToSchema, parseFeatureList } from '../../seo/parsers';
import { getContentDates } from '../../integrations/content-dates/resolver.ts';
import { filterTocHeadings } from '../../utils/content';
import { getAllTools, getAllToolSummaries, getToolSlug } from '../../utils/tools';
import { buildToolTitle } from '../../utils/seo';
import ToolLayout from '../../layouts/ToolLayout.astro';
// WidgetRenderer is auto-generated by the widgetMap() Astro integration.
// @widget-renderer is a Vite alias registered by core-pages.ts that always resolves
// to the site's src/generated/WidgetRenderer.astro — never to core/src/generated/.
import WidgetRenderer from '@widget-renderer';

export async function getStaticPaths() {
  const tools = await getAllTools();
  return tools.map(entry => ({
    params: { tool: getToolSlug(entry) },
    props: { entry, slug: getToolSlug(entry) },
  }));
}

const { entry, slug } = Astro.props;
const { Content, headings } = await render(entry);

// TOC: frontmatter `toc` overrides site global; filterTocHeadings handles all threshold logic.
const tocHeadings = filterTocHeadings(headings, entry.data.toc);
const tocTitle    = siteConfig.features.toolPage.toc?.title ?? 'On this page';

// getAllToolSummaries() returns sorted (order → alpha) draft-filtered lightweight tool data.
// Astro caches getCollection() across the build pass — zero extra I/O overhead.
const allTools = await getAllToolSummaries();

// If widgetSlug is set in frontmatter, use that tool's widget instead of this page's own.
// This allows multiple content pages (SEO aliases) to share one Svelte widget.
// E.g. systematic-investment-plan-calculator reuses the sip-calculator widget.
const effectiveWidgetSlug = entry.data.widgetSlug ?? slug;

// Check server-side whether a Widget.svelte exists for this tool.
// Used to conditionally render the tool container card — no empty box for article-only tools.
const widgetPath = join(process.cwd(), 'src', 'features', effectiveWidgetSlug, 'Widget.svelte');
const hasWidget = existsSync(widgetPath);


// Dates are pre-resolved by the content-dates integration at build time.
// Fallback hierarchy: frontmatter publishedAt/updatedAt → git → publishedAt.
// No buildTime or siteConfig.datePublished involved.
const { publishedAt, updatedAt } = getContentDates('tools', slug);

// Parse FAQ, HowTo schemas and Features list from markdown body using shared utilities
const faqSchema = parseFaqSchema(entry.body);
const howToSchema = parseHowToSchema(entry.body, entry.data.title, entry.data.description);
const parsedFeatureList = parseFeatureList(entry.body, entry.data.title);

---

<ToolLayout 
	title={buildToolTitle(entry.data.title, entry.data.seoTitle, entry.data.category)} 
	toolTitle={entry.data.title} 
	category={entry.data.category}
	description={entry.data.description}
	publishedAt={publishedAt}
	faqSchema={faqSchema}
	howToSchema={howToSchema}
	updatedAt={updatedAt}
	tools={allTools}
	canonical={entry.data.canonical}
	tags={entry.data.tags}
	featureList={parsedFeatureList ?? undefined}
	widgetSlug={effectiveWidgetSlug}
	hasWidget={hasWidget}
	fullWidth={entry.data.fullWidth}
	hasMath={entry.data.hasMath}
	tocHeadings={tocHeadings}
	tocTitle={tocTitle}
	authorRef={entry.data.author}
	coAuthorRefs={entry.data.coAuthors}
>

    <Fragment slot="description">{entry.data.description}</Fragment>

    {/* 
        Widget container: only rendered when a Widget.svelte exists for this tool.
        If the tool is article-only (no widget), this block is completely suppressed
        so no empty card appears on the page.
    */}
    {hasWidget && (
        <WidgetRenderer slug={effectiveWidgetSlug} />
    )}


    {/* The Markdown Content */}
    <Fragment slot="content"><Content /></Fragment>
</ToolLayout>
