---
/**
 * Tools Index — All free online tools, listed by category.
 *
 * This page serves as the canonical hub for all tool pages:
 *   - Every tool's breadcrumb "Tools" crumb links here (/tools)
 *   - Provides CollectionPage + ItemList schema for SEO
 *   - Mirrors the categories/index.astro pattern but scoped to /tools
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/common/sections/Header.astro';
import Footer from '../../components/common/sections/Footer.astro';
import ToolGrid from '../../components/tools-grid/ToolGrid.astro';
import CategoryHeroSection from '../../components/common/sections/CategoryHeroSection.astro';
import { siteConfig } from 'virtual:site-config';
import { categoryToSlug } from '@mtools/core/utils/slug';
import { FolderOpen } from '@lucide/svelte';
import JsonLd from '../../seo/JsonLd.astro';
import { buildWebPageSchema, buildItemListSchema } from '../../seo';
import { getAllToolSummaries } from '../../utils/tools';

// getAllToolSummaries() returns sorted (order → alpha) draft-filtered lightweight data.
// Astro caches getCollection() across the build pass — zero extra I/O overhead.
const allTools = await getAllToolSummaries();

// Derive unique, sorted category list from all published tools.
const categories = [...new Set(allTools.map(t => t.data.category))].sort();

const seoUrl = new URL('/tools', siteConfig.url).href;

// CollectionPage schema — marks this as a curated directory page.
const pageSchema = buildWebPageSchema({
	type: 'CollectionPage',
	name: `All Free Online Tools - ${siteConfig.name}`,
	description: 'Browse our complete directory of free, privacy-focused, and lightning-fast online tools. No sign-up required.',
	url: seoUrl,
	websiteUrl: siteConfig.url,
});

// ItemList schema — lists every published tool for Google's rich results.
const itemListSchema = buildItemListSchema({
	name: `All Free Online Tools - ${siteConfig.name}`,
	description: 'A comprehensive directory of privacy-focused calculators, converters, and utilities.',
	url: seoUrl,
	items: allTools.map(tool => ({
		name:            tool.data.title,
		url:             new URL(`/tools/${tool.slug}`, siteConfig.url).href,
		categoryMapping: siteConfig.seo.categoryMappings[tool.data.category] || { appCategory: 'UtilitiesApplication' },
		operatingSystem: siteConfig.seo.softwareApplication.operatingSystem || 'Any',
		priceCurrency:   siteConfig.localization?.currencyCode || 'USD',
	})),
});
---

<BaseLayout
	title={`All Free Online Tools and Calculators - ${siteConfig.name}`}
	description="Browse our complete directory of free, privacy-focused, and lightning-fast online tools. Calculators, converters, text tools, and more. No sign-up required."
	canonicalURL={seoUrl}
>
	<Fragment slot="head">
		<JsonLd schema={pageSchema} />
		<JsonLd schema={itemListSchema} />
	</Fragment>

	<Header />
	<main class="flex-1">
		<CategoryHeroSection
			badge="Complete Tools Directory"
			title="All Free Online Tools"
			subtitle="Browse our full collection of privacy-focused, lightning-fast tools. No tracking, no sign-up. Just pure utility."
		/>

		<div class="container mx-auto px-4 py-16 space-y-24">
			{categories.map((category) => (
				<section class="space-y-8">
					<div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 border-b border-border/50 pb-4">
						<div class="space-y-1">
							<h2 class="text-3xl font-bold tracking-tight flex items-center gap-3">
								<FolderOpen class="text-primary size-6" />
								{category}
							</h2>
						</div>
						<a
							href={`/categories/${categoryToSlug(category)}`}
							class="hidden sm:inline-flex items-center justify-center whitespace-nowrap rounded-md text-sm font-medium ring-offset-background transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 border border-input bg-background hover:bg-accent hover:text-accent-foreground h-10 px-4 py-2"
						>
							View all {category} tools &rarr;
						</a>
					</div>

					<ToolGrid category={category} maxItems={4} />

					<div class="sm:hidden pt-4 flex justify-center border-t border-border/30">
						<a
							href={`/categories/${categoryToSlug(category)}`}
							class="inline-flex w-full items-center justify-center whitespace-nowrap rounded-md text-sm font-medium ring-offset-background transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 border border-input bg-background hover:bg-accent hover:text-accent-foreground h-11 px-8 py-2"
						>
							View all {category} tools &rarr;
						</a>
					</div>
				</section>
			))}
		</div>
	</main>
	<Footer />
</BaseLayout>
