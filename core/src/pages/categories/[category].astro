---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/common/sections/Header.astro";
import Footer from "../../components/common/sections/Footer.astro";
import ToolGrid from "../../components/tools-grid/ToolGrid.astro";
import CategoryHeroSection from "../../components/common/sections/CategoryHeroSection.astro";
import { siteConfig } from 'virtual:site-config';
import { categoryToSlug } from '@mtools/core/utils/slug';
import JsonLd from "../../seo/JsonLd.astro";
import { buildItemListSchema } from "../../seo";
import { getAllToolSummaries, getToolSummariesByCategory } from "../../utils/tools";

export async function getStaticPaths() {
  const allTools = await getAllToolSummaries();
  const categories = [...new Set(allTools.map(t => t.data.category))];
  return categories.map(category => ({
    params: { category: categoryToSlug(category) },
    props: { categoryName: category },
  }));
}

const { categoryName } = Astro.props;
const seoUrl = new URL(Astro.url.pathname, siteConfig.url).href;
const { categoryPage } = siteConfig.content.pages;

/** Replaces {category} in a template string with the actual category name. */
const t = (template: string) => template.replace('{category}', categoryName);

// Get tools for this category to populate the ItemList schema.
// getToolSummariesByCategory() returns sorted (order → alpha) draft-filtered summaries.
const categoryTools = await getToolSummariesByCategory(categoryName);

const itemListSchema = buildItemListSchema({
	name: `${categoryName} Tools`,
	description: t(categoryPage.descriptionTemplate),
	url: seoUrl,
	items: categoryTools.map(tool => ({
		name: tool.data.title,
		url: new URL(`/tools/${tool.slug}`, siteConfig.url).href,
		categoryMapping: siteConfig.seo.categoryMappings[categoryName] || { appCategory: "UtilitiesApplication" },
		operatingSystem: siteConfig.seo.softwareApplication.operatingSystem || "Any",
		priceCurrency: siteConfig.localization?.currencyCode || "USD",
	})),
});
---

<BaseLayout title={t(categoryPage.titleTemplate)} canonicalURL={seoUrl} description={t(categoryPage.descriptionTemplate)}>
	<Fragment slot="head">
		<JsonLd schema={itemListSchema} />
	</Fragment>
	<Header />
	<main class="flex-1">
		<CategoryHeroSection
			badge={categoryPage.heroBadge}
			title={categoryName}
			subtitle={t(categoryPage.descriptionTemplate)}
		/>

		<section class="py-16 px-4">
			<div class="container mx-auto">
				<ToolGrid category={categoryName} />
			</div>
		</section>
	</main>
	<Footer />
</BaseLayout>
