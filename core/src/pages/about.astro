---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/common/sections/Header.astro";
import Footer from "../components/common/sections/Footer.astro";
import StandardProse from "../components/common/typography/StandardProse.astro";
import { siteConfig } from 'virtual:site-config';
import JsonLd from "../seo/JsonLd.astro";
import { buildWebPageSchema } from "../seo";

const seoUrl = new URL('/about', siteConfig.url).href;
const pageTitle = `About Us - ${siteConfig.name}`;
const pageDescription = `Learn about ${siteConfig.name}, who we are, why we built this, and what we believe about free, fast, and private web tools.`;

const aboutSchema = buildWebPageSchema({
	type: 'AboutPage',
	name: pageTitle,
	description: pageDescription,
	url: seoUrl,
	websiteUrl: siteConfig.url,
});
---
<BaseLayout title={pageTitle} canonicalURL={seoUrl} description={pageDescription}>
	<Fragment slot="head">
		<JsonLd schema={aboutSchema} />
	</Fragment>
	<Header />
	<main class="flex-1 container mx-auto px-4 py-16 max-w-4xl">
		<StandardProse>
			<h1>About {siteConfig.name}</h1>

			<p class="lead">We build tools that actually work. No accounts, no paywalls, no nonsense.</p>

			<h2>Why We Built This</h2>
			<p>
				Most online tools have the same problem. They are either buried behind a sign-up wall,
				slow to load, cluttered with ads that break the experience, or they ask for way more
				than they need. We got tired of that, so we built {siteConfig.name}.
			</p>
			<p>
				The idea is straightforward: a clean, growing collection of utility tools that you can
				just open and use. No account required. No installation. No premium tier locking away
				the features you actually need. Just tools that do what they say.
			</p>

			<h2>How It Works</h2>
			<p>
				Almost everything on {siteConfig.name} runs directly in your browser. When you use one
				of our tools, your data (your files, your numbers, your text) stays on your device.
				It never touches our servers. We think that is the right way to build tools that
				people trust, and we are not going to change that.
			</p>
			<p>
				The site is free because we use non-intrusive ads and, on some pages, affiliate links
				to products we think are genuinely useful. That is how we keep the lights on. We are
				transparent about it, so you can read our <a href="/affiliate-disclosure">Affiliate Disclosure</a> if
				you want the full picture.
			</p>

			<h2>Who We Are</h2>
			<p>
				We are a small, independent team of engineers and designers. There is no big marketing
				department here. We build things because we think they are useful, we fix things when
				they break, and we actually pay attention to feedback from people who use the site.
			</p>
			<p>
				We add new tools when we see a real need for them, not just to fill a page. If you
				have been looking for something and could not find a decent free version of it, there
				is a good chance we have thought about building it too.
			</p>

			<h2>Get in Touch</h2>
			<p>
				If something is broken, a tool is giving you wrong results, or you have an idea for
				something we should build, we genuinely want to hear it. Send us a message through
				our <a href="/contact">Contact Page</a> and we will get back to you.
			</p>
		</StandardProse>
	</main>
	<Footer />
</BaseLayout>
