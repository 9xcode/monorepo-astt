---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/common/sections/Header.astro";
import Footer from "../components/common/sections/Footer.astro";
import StandardProse from "../components/common/typography/StandardProse.astro";
import { siteConfig } from 'virtual:site-config';
import JsonLd from "../seo/JsonLd.astro";
import { buildWebPageSchema } from "../seo";

const seoUrl = new URL('/about', siteConfig.url).href;
const pageTitle = `About Us - ${siteConfig.name}`;
const pageDescription = `Learn more about ${siteConfig.name}, our mission, and our commitment to privacy and providing top-tier free tools and calculators for everyone.`;

const aboutSchema = buildWebPageSchema({
	type: 'AboutPage',
	name: pageTitle,
	description: pageDescription,
	url: seoUrl,
	websiteUrl: siteConfig.url,
});
---
<BaseLayout title={pageTitle} canonicalURL={seoUrl} description={pageDescription}>
	<Fragment slot="head">
		<JsonLd schema={aboutSchema} />
	</Fragment>
	<Header />
	<main class="flex-1 container mx-auto px-4 py-16 max-w-4xl">
		<StandardProse>
			<h1>About {siteConfig.name}</h1>

			<p class="lead">At {siteConfig.name}, we believe that powerful, useful software should be accessible to everyone — free, fast, and built with privacy in mind.</p>

			<h2>Our Mission</h2>
			<p>We built {siteConfig.name} because we saw a gap: most online tools are either paywalled, slow, or packed with unnecessary complexity. Our mission is simple — provide a growing collection of high-quality, browser-based utility tools that just work, without requiring accounts, installations, or subscriptions.</p>

			<h2>Why Choose Us?</h2>
			<ul>
				<li><strong>Privacy by Design:</strong> The vast majority of our tools run entirely in your browser. Your files, inputs, and data are processed locally on your device and are never uploaded to our servers.</li>
				<li><strong>Blazing Fast:</strong> Built with modern web technologies (Astro and Svelte), our tools load instantly — no spinners, no waiting.</li>
				<li><strong>Always Free:</strong> Our core toolset will always be free. We sustain the platform through non-intrusive advertising and optional affiliate partnerships — this is what keeps the lights on without charging you.</li>
				<li><strong>Constantly Growing:</strong> We are continuously adding new tools across categories including finance, productivity, development, image processing, document utilities, and more.</li>
			</ul>

			<h2>Who We Are</h2>
			<p>We are a small, independent team of software engineers and designers who are passionate about building tools that solve real everyday problems. We listen to our community and ship updates based on what our users actually need.</p>

			<h2>Get in Touch</h2>
			<p>We love hearing from our users. If you want to request a new tool, report a bug, or just say hello, reach out via our <a href="/contact">Contact Page</a>.</p>
		</StandardProse>
	</main>
	<Footer />
</BaseLayout>
