---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/common/sections/Header.astro";
import Footer from "../components/common/sections/Footer.astro";
import { siteConfig } from 'virtual:site-config';
import { coreConfig } from '../config/defaults.ts';
import {
	Coffee,
	Heart,
	CreditCard,
	Star,
	Smartphone,
	Lock,
	Leaf,
	Gift,
	Link2,
	Share2,
	MessageSquarePlus,
	Coins,
	Repeat2,
} from '@lucide/svelte';
import JsonLd from "../seo/JsonLd.astro";
import { buildWebPageSchema } from "../seo";

const s = coreConfig.support;

const qrImages = import.meta.glob<{ default: { src: string } }>('../assets/images/*.{jpeg,jpg,png,gif,webp}', { eager: true });
const resolvedQrImage = s.upi.qrImagePath ? (qrImages[s.upi.qrImagePath]?.default?.src || s.upi.qrImagePath) : null;

const seoUrl = new URL('/support', siteConfig.url).href;
const pageTitle = `Support Us - ${siteConfig.name}`;
const pageDescription = `${siteConfig.name} is free for everyone. If our tools saved you time, here are a few ways to help keep them that way.`;

const supportSchema = buildWebPageSchema({
	type: 'WebPage',
	name: pageTitle,
	description: pageDescription,
	url: seoUrl,
	websiteUrl: siteConfig.url,
});

const hasCrypto     = s.crypto.eth || s.crypto.btc;
const hasAggregators = s.cointree.url || s.xmrchat.url;
const hasCryptoSection = hasCrypto || hasAggregators;
---
<BaseLayout title={pageTitle} canonicalURL={seoUrl} description={pageDescription}>
	<Fragment slot="head">
		<JsonLd schema={supportSchema} />
	</Fragment>

	<Header />

	<main class="flex-1 container mx-auto px-4 py-16 max-w-3xl">

		<!-- Hero -->
		<div class="text-center space-y-3 mb-14">
			<h1 class="text-4xl font-bold tracking-tight">Support {siteConfig.name}</h1>
			<p class="text-muted-foreground max-w-xl mx-auto">
				All tools are free, with no logins and no paywalls.
				If something here saved you time, a small tip helps keep it running.
			</p>
		</div>

		<!-- ── Section 1: One-time tip ──────────────────────────────────────── -->
		<section class="mb-12">
			<h2 class="text-xs font-semibold uppercase tracking-widest text-muted-foreground mb-4">Send a tip</h2>
			<div class="grid sm:grid-cols-3 gap-3">
				{s.buyMeACoffee.url && (
					<a
						href={s.buyMeACoffee.url}
						target="_blank"
						rel="noopener noreferrer"
						class="flex items-center gap-3 px-4 py-3 rounded-xl border border-border bg-card hover:bg-muted/60 hover:border-primary/40 transition-all text-sm font-medium shadow-sm group"
					>
						<Coffee class="size-4 shrink-0 text-muted-foreground group-hover:text-primary transition-colors" />
						<span>Buy Me a Coffee</span>
					</a>
				)}
				{s.kofi.url && (
					<a
						href={s.kofi.url}
						target="_blank"
						rel="noopener noreferrer"
						class="flex items-center gap-3 px-4 py-3 rounded-xl border border-border bg-card hover:bg-muted/60 hover:border-primary/40 transition-all text-sm font-medium shadow-sm group"
					>
						<Heart class="size-4 shrink-0 text-muted-foreground group-hover:text-primary transition-colors" />
						<span>Ko-fi</span>
					</a>
				)}
				{s.paypal.url && (
					<a
						href={s.paypal.url}
						target="_blank"
						rel="noopener noreferrer"
						class="flex items-center gap-3 px-4 py-3 rounded-xl border border-border bg-card hover:bg-muted/60 hover:border-primary/40 transition-all text-sm font-medium shadow-sm group"
					>
						<CreditCard class="size-4 shrink-0 text-muted-foreground group-hover:text-primary transition-colors" />
						<span>PayPal</span>
					</a>
				)}
			</div>
		</section>

		<!-- ── Section 2: Recurring ──────────────────────────────────────────── -->
		{(s.kofi.url || s.githubSponsors.url || s.patreon.url) && (
			<section class="mb-12">
				<h2 class="text-xs font-semibold uppercase tracking-widest text-muted-foreground mb-4">Recurring support</h2>
				<div class="grid sm:grid-cols-3 gap-3">
					{s.kofi.url && (
						<a
							href={s.kofi.url}
							target="_blank"
							rel="noopener noreferrer"
							class="flex items-center gap-3 p-4 rounded-xl border border-border bg-card hover:bg-muted/60 hover:border-primary/40 transition-all shadow-sm group"
						>
							<div class="rounded-lg bg-muted p-2 shrink-0">
								<Repeat2 class="size-4 text-muted-foreground group-hover:text-primary transition-colors" />
							</div>
							<div class="flex-1 min-w-0">
								<p class="text-sm font-semibold group-hover:text-primary transition-colors">Ko-fi</p>
								<p class="text-xs text-muted-foreground">Monthly membership</p>
							</div>
						</a>
					)}
					{s.githubSponsors.url && (
						<a
							href={s.githubSponsors.url}
							target="_blank"
							rel="noopener noreferrer"
							class="flex items-center gap-3 p-4 rounded-xl border border-border bg-card hover:bg-muted/60 hover:border-primary/40 transition-all shadow-sm group"
						>
							<div class="rounded-lg bg-muted p-2 shrink-0">
								<Star class="size-4 text-muted-foreground group-hover:text-primary transition-colors" />
							</div>
							<div class="flex-1 min-w-0">
								<p class="text-sm font-semibold group-hover:text-primary transition-colors">GitHub Sponsors</p>
								<p class="text-xs text-muted-foreground">Monthly or yearly tiers</p>
							</div>
						</a>
					)}
					{s.patreon.url && (
						<a
							href={s.patreon.url}
							target="_blank"
							rel="noopener noreferrer"
							class="flex items-center gap-3 p-4 rounded-xl border border-border bg-card hover:bg-muted/60 hover:border-primary/40 transition-all shadow-sm group"
						>
							<div class="rounded-lg bg-muted p-2 shrink-0">
								<svg viewBox="0 0 24 24" class="size-4 text-muted-foreground group-hover:text-primary transition-colors" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
									<path d="M0 .48v23.04h4.13V.48H0zm13.62 0C8.42.48 4.18 4.72 4.18 9.93c0 5.2 4.24 9.45 9.44 9.45 5.2 0 9.44-4.24 9.44-9.45C23.06 4.72 18.82.48 13.62.48z"/>
								</svg>
							</div>
							<div class="flex-1 min-w-0">
								<p class="text-sm font-semibold group-hover:text-primary transition-colors">Patreon</p>
								<p class="text-xs text-muted-foreground">Monthly tiers & benefits</p>
							</div>
						</a>
					)}
				</div>
			</section>
		)}

		<!-- ── Section 3: UPI ────────────────────────────────────────────────── -->
		{s.upi.id && (
			<section class="mb-12">
				<h2 class="text-xs font-semibold uppercase tracking-widest text-muted-foreground mb-4">UPI</h2>
				<div class="rounded-xl border border-border bg-card flex flex-row items-stretch overflow-hidden shadow-sm">
					<div class="p-3 sm:p-4 flex flex-col justify-center flex-1 border-r border-border min-w-0">
						<div class="flex items-center gap-2 mb-1.5 sm:mb-2">
							<div class="rounded-md bg-muted p-1 sm:p-1.5 shrink-0 hidden sm:block">
								<Smartphone class="size-4 text-muted-foreground" />
							</div>
							<p class="text-xs sm:text-sm font-semibold leading-none">Pay via UPI</p>
						</div>
						<p class="text-[11px] sm:text-xs text-muted-foreground mb-2 sm:mb-3 leading-snug">
							Scan QR or copy the UPI ID to send a tip.
						</p>
						<div class="flex items-center gap-2 bg-muted rounded-lg px-2 sm:px-3 py-1.5 sm:py-2">
							<code class="text-[10px] sm:text-xs font-mono flex-1 truncate text-left">{s.upi.id}</code>
							<button
								data-copy={s.upi.id}
								onclick="copyVal(this)"
								class="text-[10px] sm:text-xs font-semibold text-primary hover:underline underline-offset-4 shrink-0 cursor-pointer bg-transparent border-0 p-0"
							>Copy</button>
						</div>
					</div>
					<div class="p-3 sm:p-4 flex items-center justify-center bg-muted/20 shrink-0">
						{resolvedQrImage ? (
							<div class="p-1 sm:p-1.5 bg-white rounded-lg shadow-sm border border-border">
								<img
									src={resolvedQrImage}
									alt="UPI QR code"
									class="w-16 h-16 sm:w-20 sm:h-20 rounded-md object-cover"
									loading="lazy"
								/>
							</div>
						) : (
							<div class="p-1 sm:p-1.5 bg-white rounded-lg shadow-sm border border-border opacity-50 grayscale">
								<div class="w-16 h-16 sm:w-20 sm:h-20 rounded-md border border-dashed border-muted-foreground/40 flex items-center justify-center text-[10px] text-muted-foreground text-center leading-tight px-1">
									QR soon
								</div>
							</div>
						)}
					</div>
				</div>
			</section>
		)}
		
		<!-- ── Section 4: Crypto ─────────────────────────────────────────────── -->
		{hasCryptoSection && (
			<section class="mb-12">
				<h2 class="text-xs font-semibold uppercase tracking-widest text-muted-foreground mb-4">Crypto</h2>
				<div class="space-y-3">
					{(s.cointree.url || s.xmrchat.url) && (
						<div class="grid sm:grid-cols-2 gap-3">
							{s.cointree.url && (
								<a
									href={s.cointree.url}
									target="_blank"
									rel="noopener noreferrer"
									class="flex items-center gap-3 p-4 rounded-xl border border-border bg-card hover:bg-muted/60 hover:border-primary/40 transition-all shadow-sm group"
								>
									<div class="rounded-lg bg-muted p-2 shrink-0">
										<Leaf class="size-4 text-muted-foreground group-hover:text-primary transition-colors" />
									</div>
									<div class="flex-1 min-w-0">
										<p class="text-sm font-semibold group-hover:text-primary transition-colors">CoinTr.ee</p>
										<p class="text-xs text-muted-foreground">All wallets in one page</p>
									</div>
								</a>
							)}
							{s.xmrchat.url && (
								<a
									href={s.xmrchat.url}
									target="_blank"
									rel="noopener noreferrer"
									class="flex items-center gap-3 p-4 rounded-xl border border-border bg-card hover:bg-muted/60 hover:border-primary/40 transition-all shadow-sm group"
								>
									<div class="rounded-lg bg-muted p-2 shrink-0">
										<Lock class="size-4 text-muted-foreground group-hover:text-primary transition-colors" />
									</div>
									<div class="flex-1 min-w-0">
										<p class="text-sm font-semibold group-hover:text-primary transition-colors">XMR Chat</p>
										<p class="text-xs text-muted-foreground">Monero tips and messages</p>
									</div>
								</a>
							)}
						</div>
					)}

					{s.crypto.eth && (
						<div class="flex items-center gap-3 bg-muted rounded-xl px-4 py-3">
							<Coins class="size-4 shrink-0 text-muted-foreground" />
							<span class="text-xs font-semibold text-muted-foreground w-7 shrink-0">ETH</span>
							<code class="text-xs font-mono flex-1 truncate">{s.crypto.eth}</code>
							<button
								data-copy={s.crypto.eth}
								onclick="copyVal(this)"
								class="text-xs font-semibold text-primary hover:underline underline-offset-4 shrink-0 cursor-pointer bg-transparent border-0 p-0"
							>Copy</button>
						</div>
					)}
					{s.crypto.btc && (
						<div class="flex items-center gap-3 bg-muted rounded-xl px-4 py-3">
							<Coins class="size-4 shrink-0 text-muted-foreground" />
							<span class="text-xs font-semibold text-muted-foreground w-7 shrink-0">BTC</span>
							<code class="text-xs font-mono flex-1 truncate">{s.crypto.btc}</code>
							<button
								data-copy={s.crypto.btc}
								onclick="copyVal(this)"
								class="text-xs font-semibold text-primary hover:underline underline-offset-4 shrink-0 cursor-pointer bg-transparent border-0 p-0"
							>Copy</button>
						</div>
					)}
				</div>
			</section>
		)}

		<!-- Divider -->
		<div class="border-t border-border my-10"></div>

		<!-- ── Section 5: No-cost ways ───────────────────────────────────────── -->
		<section class="mb-10">
			<h2 class="text-xs font-semibold uppercase tracking-widest text-muted-foreground mb-4">Other ways to help</h2>
			<div class="grid sm:grid-cols-2 gap-4">

				<!-- Share / Backlink -->
				<div class="p-5 rounded-xl border border-border bg-card space-y-4">
					<div class="flex items-start gap-3">
						<div class="rounded-lg bg-muted p-2 shrink-0 mt-0.5">
							<Link2 class="size-4 text-muted-foreground" />
						</div>
						<div>
							<p class="text-sm font-semibold">Share or add a backlink</p>
							<p class="text-xs text-muted-foreground mt-1">
								Mention {siteConfig.name} in a blog post, a Reddit thread, or anywhere your audience might benefit.
							</p>
						</div>
					</div>
					<div class="flex items-center gap-2 bg-muted rounded-lg px-3 py-2.5">
						<code class="text-xs font-mono flex-1 truncate">{siteConfig.url}</code>
						<button
							data-copy={siteConfig.url}
							onclick="copyVal(this)"
							class="text-xs font-semibold text-primary hover:underline underline-offset-4 shrink-0 cursor-pointer bg-transparent border-0 p-0"
						>Copy</button>
					</div>
					<div class="flex gap-2">
						<a
							href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(siteConfig.name + ' — free online tools')}&url=${encodeURIComponent(siteConfig.url)}`}
							target="_blank"
							rel="noopener noreferrer"
							class="flex-1 flex items-center justify-center gap-1.5 px-3 py-2 rounded-lg border border-border text-xs font-medium hover:bg-muted transition-colors"
						>
							<Share2 class="size-3" /> Post on X
						</a>
						<a
							href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(siteConfig.url)}`}
							target="_blank"
							rel="noopener noreferrer"
							class="flex-1 flex items-center justify-center gap-1.5 px-3 py-2 rounded-lg border border-border text-xs font-medium hover:bg-muted transition-colors"
						>
							<Share2 class="size-3" /> LinkedIn
						</a>
					</div>
				</div>

				<!-- Right column: Wishlist + Feedback stacked -->
				<div class="flex flex-col gap-4">

					{s.wishlist.url && (
						<a
							href={s.wishlist.url}
							target="_blank"
							rel="noopener noreferrer"
							class="flex items-start gap-3 p-5 rounded-xl border border-border bg-card hover:bg-muted/60 hover:border-primary/40 transition-all group"
						>
							<div class="rounded-lg bg-muted p-2 shrink-0 mt-0.5">
								<Gift class="size-4 text-muted-foreground group-hover:text-primary transition-colors" />
							</div>
							<div class="flex-1 min-w-0">
								<p class="text-sm font-semibold group-hover:text-primary transition-colors">Wishlist</p>
								<p class="text-xs text-muted-foreground mt-1">
									Pick something off the wishlist. Every item helps directly with development or hardware.
								</p>
							</div>
						</a>
					)}

					<div class="flex items-start gap-3 p-5 rounded-xl border border-border bg-card">
						<div class="rounded-lg bg-muted p-2 shrink-0 mt-0.5">
							<MessageSquarePlus class="size-4 text-muted-foreground" />
						</div>
						<div>
							<p class="text-sm font-semibold">Send feedback</p>
							<p class="text-xs text-muted-foreground mt-1">
								Tell us what tools you need, what is broken, or what could be better. It shapes what we build next.
							</p>
							<a href="/contact" class="inline-block mt-2 text-xs font-semibold text-primary hover:underline underline-offset-4">
								Go to contact page &rarr;
							</a>
						</div>
					</div>

				</div>
			</div>
		</section>

		<!-- Footer note -->
		<div class="text-center border-t border-border pt-10 mt-6">
			<p class="text-sm text-muted-foreground max-w-lg mx-auto">
				Using the tools is already enough. If you cannot support financially right now, that is completely fine.
			</p>
		</div>

	</main>

	<Footer />
</BaseLayout>

<script>
	function copyVal(btn: HTMLButtonElement) {
		const val = btn.dataset.copy;
		if (!val) return;
		navigator.clipboard.writeText(val).then(() => {
			const original = btn.textContent;
			btn.textContent = 'Copied!';
			setTimeout(() => { btn.textContent = original; }, 2000);
		});
	}
	(window as any).copyVal = copyVal;
</script>
