---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/common/sections/Header.astro";
import Footer from "../components/common/sections/Footer.astro";
import { Button } from "$lib/components/ui/button";
import { House, Search } from '@lucide/svelte';
import { siteConfig } from 'virtual:site-config';

const seoUrl = new URL('/404', siteConfig.url).href;
---

<BaseLayout title={`404: Page Not Found - ${siteConfig.name}`} canonicalURL={seoUrl} description="The page you are looking for does not exist. Return home to browse our free calculators and tools." type="website">
	<Fragment slot="head">
		<meta name="robots" content="noindex, nofollow" />
	</Fragment>
	<Header />
	<main class="flex-1 flex flex-col items-center justify-center p-4 min-h-[60vh] text-center space-y-8">
		<div class="space-y-4 max-w-xl">
			<div class="inline-flex items-center rounded-full border px-2.5 py-0.5 text-xs font-semibold bg-primary/10 text-primary border-primary/20 uppercase tracking-wider">
                Error 404
            </div>
			<h1 class="text-5xl md:text-7xl font-bold tracking-tight bg-clip-text text-transparent bg-gradient-to-r from-primary to-primary/60">
				Page Not Found.
			</h1>
			<p class="text-xl text-muted-foreground leading-relaxed">
				Oops! We couldn't find the tool or page you were looking for. It might have been moved or deleted.
			</p>
		</div>
		
		<div class="flex flex-col sm:flex-row gap-4 pt-4">
			<Button size="lg" href="/" class="gap-2 px-8 text-base shadow-lg">
				<House class="size-5" /> Return Home
			</Button>
			<Button size="lg" variant="outline" href="/categories" class="gap-2 px-8 text-base">
				<Search class="size-5" /> Browse Tools
			</Button>
		</div>
	</main>
	<Footer />
</BaseLayout>
