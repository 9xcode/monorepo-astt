---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/common/sections/Header.astro";
import Footer from "../components/common/sections/Footer.astro";

import AppHero from "../components/mobile-app/sections/AppHero.astro";
import AppFeatures from "../components/mobile-app/sections/AppFeatures.astro";
import AppTools from "../components/mobile-app/sections/AppTools.astro";
import AppHowItWorks from "../components/mobile-app/sections/AppHowItWorks.astro";
import AppTestimonials from "../components/mobile-app/sections/AppTestimonials.astro";
import AppFAQ from "../components/mobile-app/sections/AppFAQ.astro";
import AppBottomCTA from "../components/mobile-app/sections/AppBottomCTA.astro";

import { siteConfig } from 'virtual:site-config';
import JsonLd from "../seo/JsonLd.astro";
import { buildSoftwareAppSchema } from "../seo";

const seoUrl = new URL('/mobile-app', siteConfig.url).href;

const appSchema = buildSoftwareAppSchema({
	name: `${siteConfig.name} Mobile App`,
	description: `Download the official ${siteConfig.name} app for offline access to all our tools. Zero tracking, blazing fast, and universal.`,
	operatingSystem: 'Android, iOS',
	applicationCategory: 'UtilitiesApplication',
	priceCurrency: siteConfig.localization.currencyCode || 'USD',
	url: seoUrl,
});
---

<BaseLayout title={`Download Mobile App - ${siteConfig.name}`} canonicalURL={seoUrl} description={`Get the ${siteConfig.name} app for iOS and Android. Experience zero-tracking, offline capabilities, and all our tools directly on your device.`}>
	<Fragment slot="head">
		<JsonLd schema={appSchema} />
	</Fragment>
	<Header />
	<main class="flex-1">
		<AppHero />
		<AppFeatures />
		<AppTools />
		<AppHowItWorks />
		<AppTestimonials />
		<AppFAQ />
		<AppBottomCTA />
	</main>
	<Footer />
</BaseLayout>
