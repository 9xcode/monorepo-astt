---
/**
 * AppTestimonials — User testimonials section for mobile app page.
 */
import { Star } from '@lucide/svelte';
import { siteConfig } from 'virtual:site-config';
---

<section class="py-24 px-4 bg-background cv-auto cv-intrinsic-h400">
	<div class="container mx-auto">
		<div class="text-center max-w-2xl mx-auto mb-16 space-y-4">
			<h2 class="text-3xl md:text-4xl font-bold tracking-tight">Loved by Thousands</h2>
			<p class="text-lg text-muted-foreground">See what our users have to say about their experience with the {siteConfig.name} app.</p>
		</div>
        <div class="grid md:grid-cols-3 gap-8">
            <div class="bg-card p-8 rounded-xl border border-border/50 shadow-sm relative">
                <div class="flex gap-1 mb-4 text-warning">
                    <Star class="size-5 fill-current" />
                    <Star class="size-5 fill-current" />
                    <Star class="size-5 fill-current" />
                    <Star class="size-5 fill-current" />
                    <Star class="size-5 fill-current" />
                </div>
                <p class="text-muted-foreground leading-relaxed mb-6">"This app is an absolute lifesaver. I use it daily and the fact that it works offline is amazing. Zero ads, pure functionality, exactly what I needed."</p>
                <div class="flex items-center gap-4">
                    <div class="size-12 rounded-full bg-muted flex items-center justify-center font-bold text-muted-foreground">AJ</div>
                    <div>
                        <div class="font-semibold text-foreground">Amit J.</div>
                        <div class="text-sm text-muted-foreground">App Store Review</div>
                    </div>
                </div>
            </div>
            <div class="bg-card p-8 rounded-xl border border-border/50 shadow-sm relative">
                <div class="flex gap-1 mb-4 text-warning">
                    <Star class="size-5 fill-current" />
                    <Star class="size-5 fill-current" />
                    <Star class="size-5 fill-current" />
                    <Star class="size-5 fill-current" />
                    <Star class="size-5 fill-current" />
                </div>
                <p class="text-muted-foreground leading-relaxed mb-6">"Finally, a perfectly designed toolset that respects my privacy. I uninstalled 4 different calculator apps after finding this one. It has literally everything I need."</p>
                <div class="flex items-center gap-4">
                    <div class="size-12 rounded-full bg-muted flex items-center justify-center font-bold text-muted-foreground">SM</div>
                    <div>
                        <div class="font-semibold text-foreground">Sarah M.</div>
                        <div class="text-sm text-muted-foreground">Play Store Review</div>
                    </div>
                </div>
            </div>
            <div class="bg-card p-8 rounded-xl border border-border/50 shadow-sm relative">
                <div class="flex gap-1 mb-4 text-warning">
                    <Star class="size-5 fill-current" />
                    <Star class="size-5 fill-current" />
                    <Star class="size-5 fill-current" />
                    <Star class="size-5 fill-current" />
                    <Star class="size-5 fill-current text-muted/30" />
                </div>
                <p class="text-muted-foreground leading-relaxed mb-6">"Extremely fast and snappy. The UI is gorgeous and the dark mode is perfect. Would give it 5 stars if they added a dedicated scientific calculator, but it's great!"</p>
                <div class="flex items-center gap-4">
                    <div class="size-12 rounded-full bg-muted flex items-center justify-center font-bold text-muted-foreground">RJ</div>
                    <div>
                        <div class="font-semibold text-foreground">Rahul J.</div>
                        <div class="text-sm text-muted-foreground">Play Store Review</div>
                    </div>
                </div>
            </div>
        </div>
	</div>
</section>
