---
/**
 * AppHero — Mobile app landing page hero section with phone mockup.
 */
import { Button } from "$lib/components/ui/button";
import { MoveRight, Smartphone, Zap, Globe, Lock, House } from '@lucide/svelte';
import { siteConfig } from 'virtual:site-config';
import { Image } from "astro:assets";
import user1 from "../../../assets/images/user-1.jpg";
import user2 from "../../../assets/images/user-2.jpg";
import user3 from "../../../assets/images/user-3.jpg";
import Logo from "../../common/ui/Logo.svelte";
---

<section class="py-24 px-4 overflow-hidden relative border-b border-border/50 bg-gradient-to-b from-background to-muted/20">
    <div class="absolute inset-0 -z-10 bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-primary/10 via-background to-background"></div>
    <div class="container mx-auto grid lg:grid-cols-2 gap-16 items-center">
        <div class="space-y-8">
            <div class="inline-flex items-center rounded-full border px-2.5 py-0.5 text-xs font-semibold bg-primary/10 text-primary border-primary/20 uppercase tracking-wider">
                iOS & Android
            </div>
            <h1 class="text-5xl md:text-7xl font-bold tracking-tight leading-tight">
                All Your Tools.<br />
                <span class="text-transparent bg-clip-text bg-gradient-to-r from-primary to-primary/60">Zero Tracking.</span>
            </h1>
            <p class="text-xl text-muted-foreground leading-relaxed max-w-lg">
                Experience the full power of {siteConfig.name} on your mobile device. Offline access, native performance, and the absolute privacy you expect.
            </p>
            <div class="flex flex-col sm:flex-row gap-4 pt-4">
                <Button size="lg" class="gap-2 h-14 px-8 text-base shadow-lg">
                    Get for iOS <MoveRight class="size-5" />
                </Button>
                <Button size="lg" variant="outline" class="gap-2 h-14 px-8 text-base bg-background/50 hover:bg-accent backdrop-blur-sm border-border/50">
                    Get for Android <MoveRight class="size-5" />
                </Button>
            </div>
            <div class="flex items-center gap-4 text-sm text-muted-foreground pt-4">
                <div class="flex -space-x-2">
                    <Image src={user1} alt="User 1" width={32} height={32} class="size-8 rounded-full border-2 border-background object-cover" />
                    <Image src={user2} alt="User 2" width={32} height={32} class="size-8 rounded-full border-2 border-background object-cover" />
                    <Image src={user3} alt="User 3" width={32} height={32} class="size-8 rounded-full border-2 border-background object-cover" />
                </div>
                <div class="flex flex-col">
                    <span class="font-medium text-foreground">Join 10,000+ users</span>
                    <span>Rated 4.9/5 on App Stores</span>
                </div>
            </div>
        </div>

        {/* Phone Mockup Container */}
        <div class="relative mx-auto w-full max-w-[320px] lg:ml-auto">
            <div class="absolute inset-0 bg-primary/20 blur-3xl -z-10 rounded-full animate-pulse"></div>
            <div class="relative rounded-[3rem] border-8 border-foreground/10 bg-foreground/5 shadow-2xl overflow-hidden ring-1 ring-border/50">
                <div class="absolute top-0 left-1/2 -translate-x-1/2 h-7 w-40 bg-foreground/10 rounded-b-3xl z-20 backdrop-blur-md"></div>
                <div class="relative rounded-[2.5rem] overflow-hidden bg-background aspect-[9/19] flex flex-col items-center">
                   <div class="p-6 pt-16 space-y-8 w-full flex-1 bg-gradient-to-b from-muted/30 to-background border-b border-border/50">
                        <div class="flex items-center justify-between">
                            <div class="flex items-center gap-2">
                                <div class="size-8 rounded-lg bg-primary flex items-center justify-center shadow-lg shadow-primary/30 ring-1 ring-primary/50">
                                    <Logo class="size-5 text-primary-foreground" />
                                </div>
                                <span class="font-bold tracking-tight">{siteConfig.name}</span>
                            </div>
                            <div class="size-8 rounded-full bg-muted flex items-center justify-center"><Smartphone class="size-4 text-muted-foreground" /></div>
                        </div>
                        <div class="space-y-4">
                            <h3 class="text-sm font-semibold uppercase tracking-wider text-muted-foreground">Top Tools</h3>
                            <div class="h-28 bg-card border rounded-xl shadow-sm p-4 space-y-3 relative overflow-hidden group">
                                <div class="absolute inset-0 bg-gradient-to-r from-primary/5 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity"></div>
                                <div class="flex items-center gap-3 relative z-10">
                                    <div class="size-10 bg-primary/10 text-primary rounded-xl flex items-center justify-center"><Zap class="size-5" /></div>
                                    <div class="space-y-2 flex-1">
                                        <div class="h-4 w-3/4 bg-foreground/80 rounded-full"></div>
                                        <div class="h-3 w-1/2 bg-muted-foreground/50 rounded-full"></div>
                                    </div>
                                </div>
                                <div class="h-8 bg-muted/50 rounded-lg relative z-10 flex items-center px-3"><div class="h-2 w-1/3 bg-muted-foreground/30 rounded-full"></div></div>
                            </div>
                            <div class="grid grid-cols-2 gap-4 pt-2">
                                <div class="h-24 bg-card border rounded-xl shadow-sm flex flex-col p-3 gap-2 justify-end">
                                    <div class="size-8 rounded-full bg-primary/10 self-end mb-auto"></div>
                                    <div class="h-2 w-2/3 bg-muted-foreground/40 rounded-full"></div>
                                    <div class="h-2 w-1/2 bg-muted-foreground/30 rounded-full"></div>
                                </div>
                                <div class="h-24 bg-card border rounded-xl shadow-sm flex flex-col p-3 gap-2 justify-end">
                                    <div class="size-8 rounded-full bg-secondary/80 self-end mb-auto"></div>
                                    <div class="h-2 w-2/3 bg-muted-foreground/40 rounded-full"></div>
                                    <div class="h-2 w-1/2 bg-muted-foreground/30 rounded-full"></div>
                                </div>
                            </div>
                        </div>
                   </div>
                   <div class="h-20 w-full bg-background/80 backdrop-blur flex items-center justify-around px-8">
                        <div class="size-12 flex items-center justify-center rounded-full bg-primary/10 text-primary">
                            <House class="size-6" />
                        </div>
                        <div class="size-12 flex items-center justify-center text-muted-foreground"><Globe class="size-6" /></div>
                        <div class="size-12 flex items-center justify-center text-muted-foreground"><Lock class="size-6" /></div>
                   </div>
                </div>
            </div>
        </div>
    </div>
</section>
