---
/**
 * AppHero — Mobile app landing page hero section with phone mockup.
 *
 * Store URLs and social proof stats come from siteConfig.features.getApp
 * and siteConfig.content.components.getApp.hero.
 */
import { Button } from "$lib/components/ui/button";
import { MoveRight, Zap, Compass, User, House, Clock, Heart, Search } from '@lucide/svelte';
import { siteConfig } from 'virtual:site-config';
import { Image } from "astro:assets";
import user1 from "../../../assets/images/user-1.jpg";
import user2 from "../../../assets/images/user-2.jpg";
import user3 from "../../../assets/images/user-3.jpg";
import Logo from "@site-logo";

const { appStoreUrl, playStoreUrl } = siteConfig.features.getApp;
const { userCount, ratingText } = siteConfig.content.components.getApp.hero;
---

<section class="py-24 px-4 overflow-hidden relative border-b border-border/50 bg-gradient-to-b from-background to-muted/20">
    <div class="absolute inset-0 -z-10 bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-primary/10 via-background to-background"></div>
    <div class="container mx-auto grid lg:grid-cols-2 gap-16 items-center">
        <div class="space-y-8">
            <div class="inline-flex items-center rounded-full border px-2.5 py-0.5 text-xs font-semibold bg-primary/10 text-primary border-primary/20 uppercase tracking-wider">
                iOS & Android
            </div>
            <h1 class="text-5xl md:text-7xl font-bold tracking-tight leading-tight">
                All Your Tools.<br />
                <span class="text-transparent bg-clip-text bg-gradient-to-r from-primary to-primary/60">Zero Tracking.</span>
            </h1>
            <p class="text-xl text-muted-foreground leading-relaxed max-w-lg">
                Experience the full power of {siteConfig.name} on your mobile device. Offline access, native performance, and the absolute privacy you expect.
            </p>
            <div class="flex flex-col sm:flex-row gap-4 pt-4">
                <Button size="lg" class="gap-2 h-14 px-8 text-base shadow-lg" href={appStoreUrl}>
                    Get for iOS <MoveRight class="size-5" />
                </Button>
                <Button size="lg" variant="outline" class="gap-2 h-14 px-8 text-base bg-background/50 hover:bg-accent backdrop-blur-sm border-border/50" href={playStoreUrl}>
                    Get for Android <MoveRight class="size-5" />
                </Button>
            </div>
            <div class="flex items-center gap-4 text-sm text-muted-foreground pt-4">
                <div class="flex -space-x-2">
                    <Image src={user1} alt="User 1" width={32} height={32} class="size-8 rounded-full border-2 border-background object-cover" />
                    <Image src={user2} alt="User 2" width={32} height={32} class="size-8 rounded-full border-2 border-background object-cover" />
                    <Image src={user3} alt="User 3" width={32} height={32} class="size-8 rounded-full border-2 border-background object-cover" />
                </div>
                <div class="flex flex-col">
                    <span class="font-medium text-foreground">Join {userCount} users</span>
                    <span>Rated {ratingText}</span>
                </div>
            </div>
        </div>

        {/* Phone Mockup Container */}
        <div class="relative mx-auto w-full max-w-[320px] lg:ml-auto">
            <div class="absolute inset-0 bg-primary/20 blur-3xl -z-10 rounded-full animate-pulse"></div>
            <div class="relative rounded-[3rem] border-8 border-foreground/10 bg-foreground/5 shadow-2xl overflow-hidden ring-1 ring-border/50">
                <div class="absolute top-0 left-1/2 -translate-x-1/2 h-7 w-40 bg-foreground/10 rounded-b-3xl z-20 backdrop-blur-md"></div>
                <div class="relative rounded-[2.5rem] overflow-hidden bg-background aspect-[9/19] flex flex-col items-center">
                   <div class="p-5 pt-12 space-y-5 w-full flex-1 bg-gradient-to-b from-muted/30 to-background border-b border-border/50">
                        <div class="flex items-center justify-between">
                            <div class="flex items-center gap-2">
                                <div class="size-8 rounded-lg bg-primary flex items-center justify-center shadow-lg shadow-primary/30 ring-1 ring-primary/50">
                                    <Logo class="size-5 text-primary-foreground" />
                                </div>
                                <span class="font-bold tracking-tight">{siteConfig.name}</span>
                            </div>
                            <div class="size-8 rounded-full bg-muted flex items-center justify-center hover:bg-muted/80 transition-colors cursor-pointer"><Search class="size-4 text-muted-foreground" /></div>
                        </div>
                        <div class="space-y-3">
                            <h3 class="text-xs font-semibold uppercase tracking-wider text-muted-foreground">Top Tools</h3>
                            <div class="h-28 bg-card border rounded-xl shadow-sm p-4 space-y-3 relative overflow-hidden group hover:border-primary/45 transition-colors cursor-pointer">
                                <div class="absolute inset-0 bg-gradient-to-r from-primary/5 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity"></div>
                                <div class="flex items-center gap-3 relative z-10">
                                    <div class="size-10 bg-primary/10 text-primary rounded-xl flex items-center justify-center transition-transform group-hover:scale-105"><Zap class="size-5" /></div>
                                    <div class="space-y-2 flex-1">
                                        <div class="h-4 w-3/4 bg-foreground/80 rounded-full"></div>
                                        <div class="h-3 w-1/2 bg-muted-foreground/50 rounded-full"></div>
                                    </div>
                                </div>
                                <div class="h-8 bg-muted/50 rounded-lg relative z-10 flex items-center px-3"><div class="h-2 w-1/3 bg-muted-foreground/30 rounded-full"></div></div>
                            </div>
                            <div class="grid grid-cols-2 gap-3 pt-1">
                                <div class="h-20 bg-card border border-border/60 hover:border-primary/40 rounded-xl shadow-sm flex flex-col p-3 gap-2 justify-end cursor-pointer group transition-colors">
                                    <div class="size-6 rounded-full bg-primary/10 self-end mb-auto transition-transform group-hover:scale-105"></div>
                                    <div class="h-2 w-2/3 bg-muted-foreground/40 rounded-full"></div>
                                    <div class="h-2 w-1/2 bg-muted-foreground/30 rounded-full"></div>
                                </div>
                                <div class="h-20 bg-card border border-border/60 hover:border-primary/40 rounded-xl shadow-sm flex flex-col p-3 gap-2 justify-end cursor-pointer group transition-colors">
                                    <div class="size-6 rounded-full bg-secondary/80 self-end mb-auto transition-transform group-hover:scale-105"></div>
                                    <div class="h-2 w-2/3 bg-muted-foreground/40 rounded-full"></div>
                                    <div class="h-2 w-1/2 bg-muted-foreground/30 rounded-full"></div>
                                </div>
                            </div>
                        </div>
                        
                        {/* Generic Your Workspace section containing recent and saved indicators to complete the mockup and eliminate visual whitespace */}
                        <div class="space-y-3">
                            <h3 class="text-xs font-semibold uppercase tracking-wider text-muted-foreground">Your Workspace</h3>
                            <div class="space-y-2.5">
                                <div class="h-11 bg-card border border-border/60 hover:border-primary/45 rounded-xl shadow-sm p-3 flex items-center justify-between relative overflow-hidden cursor-pointer group transition-colors">
                                    <div class="absolute inset-0 bg-gradient-to-r from-primary/5 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity"></div>
                                    <div class="flex items-center gap-2.5 flex-1 relative z-10">
                                        <div class="size-6 rounded-full bg-muted flex items-center justify-center transition-transform group-hover:scale-105"><Clock class="size-3 text-muted-foreground" /></div>
                                        <div class="h-2.5 w-24 bg-muted-foreground/40 rounded-full"></div>
                                    </div>
                                    <div class="h-2 w-10 bg-muted-foreground/30 rounded-full relative z-10"></div>
                                </div>
                                
                                <div class="h-11 bg-card border border-border/60 hover:border-primary/45 rounded-xl shadow-sm p-3 flex items-center justify-between relative overflow-hidden cursor-pointer group transition-colors">
                                    <div class="absolute inset-0 bg-gradient-to-r from-primary/5 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity"></div>
                                    <div class="flex items-center gap-2.5 flex-1 relative z-10">
                                        <div class="size-6 rounded-full bg-primary/10 flex items-center justify-center transition-transform group-hover:scale-105"><Heart class="size-3 text-primary fill-primary/10" /></div>
                                        <div class="h-2.5 w-16 bg-muted-foreground/40 rounded-full"></div>
                                    </div>
                                    <div class="h-2 w-8 bg-muted-foreground/30 rounded-full relative z-10"></div>
                                </div>

                                <div class="h-11 bg-card border border-border/60 hover:border-primary/45 rounded-xl shadow-sm p-3 flex items-center justify-between relative overflow-hidden cursor-pointer group transition-colors">
                                    <div class="absolute inset-0 bg-gradient-to-r from-primary/5 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity"></div>
                                    <div class="flex items-center gap-2.5 flex-1 relative z-10">
                                        <div class="size-6 rounded-full bg-muted flex items-center justify-center transition-transform group-hover:scale-105"><Zap class="size-3 text-muted-foreground" /></div>
                                        <div class="h-2.5 w-20 bg-muted-foreground/40 rounded-full"></div>
                                    </div>
                                    <div class="h-2 w-12 bg-muted-foreground/30 rounded-full relative z-10"></div>
                                </div>
                                
                            </div>
                        </div>
                   </div>
                   <div class="h-16 w-full bg-background/90 border-t border-border/40 backdrop-blur flex items-center justify-around px-8 relative z-10">
                        <div class="size-10 flex flex-col items-center justify-center rounded-full text-primary cursor-pointer transition-transform hover:scale-105">
                            <House class="size-5" />
                            <span class="text-[8px] font-bold mt-0.5 tracking-wide">Home</span>
                        </div>
                        <div class="size-10 flex flex-col items-center justify-center text-muted-foreground hover:text-foreground cursor-pointer transition-all hover:scale-105">
                            <Compass class="size-5" />
                            <span class="text-[8px] font-medium mt-0.5 tracking-wide">Explore</span>
                        </div>
                        <div class="size-10 flex flex-col items-center justify-center text-muted-foreground hover:text-foreground cursor-pointer transition-all hover:scale-105">
                            <User class="size-5" />
                            <span class="text-[8px] font-medium mt-0.5 tracking-wide">Profile</span>
                        </div>
                   </div>
                   
                   {/* iOS Swipe Up Home Bar Indicator */}
                   <div class="absolute bottom-1.5 left-1/2 -translate-x-1/2 h-1 w-20 bg-foreground/15 rounded-full z-20 pointer-events-none"></div>
                </div>
            </div>
        </div>
    </div>
</section>
