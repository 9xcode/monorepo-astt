---
/**
 * AppHowItWorks — 3-step process section for the get-app landing page.
 * Content is fully generic across all tool-suite sites — no config needed.
 */
import { CircleCheck } from '@lucide/svelte';
import { siteConfig } from 'virtual:site-config';
---

<section class="py-24 px-4 bg-muted/10 border-b border-border/50 cv-auto cv-intrinsic-h600">
	<div class="container mx-auto">
        <div class="grid lg:grid-cols-2 gap-16 items-center max-w-5xl mx-auto">
            <div class="order-2 lg:order-1 relative">
                <div class="absolute inset-0 bg-primary/10 blur-3xl -z-10 rounded-full"></div>
                <div class="bg-card border border-border/50 rounded-xl p-8 shadow-xl relative z-10">
                    <div class="space-y-6">
                        <div class="flex items-center gap-4 p-4 rounded-xl bg-muted/50 border border-border/50">
                            <div class="size-10 bg-primary/10 text-primary rounded-full flex items-center justify-center shrink-0">
                                <CircleCheck class="size-5" />
                            </div>
                            <div>
                                <h4 class="font-semibold">Step 1: Download</h4>
                                <p class="text-sm text-muted-foreground">Get the free app from iOS or Play Store.</p>
                            </div>
                        </div>
                        <div class="flex items-center gap-4 p-4 rounded-xl bg-muted/50 border border-border/50">
                            <div class="size-10 bg-primary/10 text-primary rounded-full flex items-center justify-center shrink-0">
                                <CircleCheck class="size-5" />
                            </div>
                            <div>
                                <h4 class="font-semibold">Step 2: Choose your Tool</h4>
                                <p class="text-sm text-muted-foreground">Select from 50+ available tools.</p>
                            </div>
                        </div>
                        <div class="flex items-center gap-4 p-4 rounded-xl bg-primary text-primary-foreground shadow-lg shadow-primary/20 scale-105 transform transition-all -ml-2 -mr-2">
                            <div class="size-10 bg-primary-foreground/20 rounded-full flex items-center justify-center shrink-0">
                                <CircleCheck class="size-5" />
                            </div>
                            <div>
                                <h4 class="font-semibold">Step 3: Calculate Instantly</h4>
                                <p class="text-sm text-primary-foreground/80">Get fast, accurate results offline.</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="order-1 lg:order-2 space-y-6 text-center lg:text-left">
                <h2 class="text-3xl md:text-4xl font-bold tracking-tight">Simplicity at its finest</h2>
                <p class="text-lg text-muted-foreground leading-relaxed">We designed the {siteConfig.name} app to get out of your way. Open the app, tap your tool, and get your calculation instantly.</p>
                <ul class="space-y-3 text-left max-w-md mx-auto lg:mx-0 pt-4">
                    <li class="flex items-center gap-3">
                        <CircleCheck class="size-5 text-primary shrink-0" />
                        <span>No annoying ads interrupting your workflow</span>
                    </li>
                    <li class="flex items-center gap-3">
                        <CircleCheck class="size-5 text-primary shrink-0" />
                        <span>No sign-up or login walls</span>
                    </li>
                    <li class="flex items-center gap-3">
                        <CircleCheck class="size-5 text-primary shrink-0" />
                        <span>Instant offline calculations</span>
                    </li>
                </ul>
            </div>
        </div>
	</div>
</section>
