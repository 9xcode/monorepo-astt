---
/**
 * AppFeatures — 4-feature grid section for the get-app landing page.
 * Content is fully generic across all tool-suite sites — no config needed.
 */
import { WifiOff, Zap, ShieldCheck, BellRing } from '@lucide/svelte';
---

<section class="py-24 px-4 bg-background cv-auto cv-intrinsic-h600">
	<div class="container mx-auto">
		<div class="text-center max-w-2xl mx-auto mb-16 space-y-4">
			<h2 class="text-3xl md:text-4xl font-bold tracking-tight">Why download the app?</h2>
			<p class="text-lg text-muted-foreground">Every feature from our web platform, optimized for your phone with native capabilities.</p>
		</div>
		<div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8">
			<div class="space-y-4 p-6 bg-card border rounded-xl hover:border-primary/50 transition-colors shadow-sm hover:shadow-md">
				<div class="size-12 bg-primary/10 text-primary rounded-xl flex items-center justify-center">
					<WifiOff class="size-6" />
				</div>
				<h3 class="text-xl font-semibold">Works Offline</h3>
				<p class="text-muted-foreground leading-relaxed">Use all your tools on an airplane, in a subway, or anywhere else. No internet connection required once downloaded.</p>
			</div>
			<div class="space-y-4 p-6 bg-card border rounded-xl hover:border-primary/50 transition-colors shadow-sm hover:shadow-md">
				<div class="size-12 bg-primary/10 text-primary rounded-xl flex items-center justify-center">
					<Zap class="size-6" />
				</div>
				<h3 class="text-xl font-semibold">Native Speed</h3>
				<p class="text-muted-foreground leading-relaxed">Built with performance in mind. Experience instantaneous calculations and smooth, fast animations.</p>
			</div>
			<div class="space-y-4 p-6 bg-card border rounded-xl hover:border-primary/50 transition-colors shadow-sm hover:shadow-md">
				<div class="size-12 bg-primary/10 text-primary rounded-xl flex items-center justify-center">
					<ShieldCheck class="size-6" />
				</div>
				<h3 class="text-xl font-semibold">Absolute Privacy</h3>
				<p class="text-muted-foreground leading-relaxed">We don't track you. All calculations stay on your device. We collect exactly zero analytics data.</p>
			</div>
			<div class="space-y-4 p-6 bg-card border rounded-xl hover:border-primary/50 transition-colors shadow-sm hover:shadow-md">
				<div class="size-12 bg-primary/10 text-primary rounded-xl flex items-center justify-center">
					<BellRing class="size-6" />
				</div>
				<h3 class="text-xl font-semibold">Smart Alerts</h3>
				<p class="text-muted-foreground leading-relaxed">Set reminders and stay on top of your tasks natively with iOS and Android push notifications.</p>
			</div>
		</div>
	</div>
</section>
