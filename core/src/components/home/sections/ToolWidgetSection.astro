---
import { siteConfig } from 'virtual:site-config';
import { getAllToolSummaries } from "../../../utils/tools";
import WidgetRenderer from "@widget-renderer";

const { enabled, toolSlug } = siteConfig.features.homepage.toolWidgetSection;
const supportUrl = siteConfig.features.support.url;

// Guard: bail out early if the feature is disabled or no slug is set.
// The rest below only runs when `enabled && toolSlug` is truthy.
// getAllToolSummaries() already filters drafts and resolves slugs.
const allTools = enabled && toolSlug ? await getAllToolSummaries() : [];
const targetTool = allTools.find(t => t.slug === toolSlug);

const shouldRender = enabled && !!toolSlug && !!targetTool;

const description = targetTool?.data.description ?? "";
---

{shouldRender && (
    <section
        id="featured-tool-widget"
        class="pt-6 pb-16 px-4 bg-background animate-in fade-in slide-in-from-bottom-4 duration-700 ease-out fill-mode-both scroll-mt-24"
    >
        <div class="container mx-auto max-w-5xl">

            {/* Window-frame card with subtle lift on hover */}
            <div class="group relative flex flex-col bg-card rounded-xl shadow-2xl border border-border overflow-hidden ring-1 ring-border/50 transition-all duration-500 hover:shadow-[0_20px_50px_rgba(0,0,0,0.12)] dark:hover:shadow-[0_20px_50px_rgba(0,0,0,0.28)] hover:-translate-y-0.5">

                {/* Subtle primary colour bloom on hover */}
                <div class="pointer-events-none absolute -inset-0.5 rounded-xl bg-gradient-to-r from-primary/5 via-transparent to-primary/5 opacity-0 transition-opacity duration-700 group-hover:opacity-100" aria-hidden="true"></div>

                {/* ── Header bar ─────────────────────────────────────── */}
                <div class="relative z-20 flex min-h-[52px] items-center justify-between gap-4 border-b border-border/50 bg-muted/10 px-5 py-3">

                    {/* Tool name — uppercase, primary colour, generous tracking */}
                    <h3 class="truncate text-[10px] font-black uppercase tracking-[0.2em] text-primary sm:text-xs select-none">
                        {targetTool?.data.title}
                    </h3>

                    {/* Buy Me a Coffee — icon-only on mobile, labelled on sm+ */}
                    {supportUrl && (
                        <a
                            href={supportUrl}
                            target="_blank"
                            rel="noopener noreferrer"
                            aria-label="Buy Me a Coffee"
                            class="group/coffee inline-flex shrink-0 items-center justify-center gap-2 rounded-lg border border-border bg-background px-3 py-1.5 text-[10px] font-bold text-muted-foreground shadow-sm transition-all hover:border-orange-500/30 hover:bg-orange-500/5 hover:text-orange-500 active:scale-95 sm:px-4 sm:py-2 sm:text-xs"
                        >
                            {/* Coffee cup — clean, correct SVG */}
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2.5"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                class="size-4 shrink-0 transition-transform group-hover/coffee:rotate-12"
                                aria-hidden="true"
                            >
                                <path d="M6 2v2"/>
                                <path d="M10 2v2"/>
                                <path d="M14 2v2"/>
                                <path d="M2 9a1 1 0 0 1 1-1h14a1 1 0 0 1 1 1v8a4 4 0 0 1-4 4H6a4 4 0 0 1-4-4z"/>
                                <path d="M18 8h2a2 2 0 1 1 0 4h-2"/>
                            </svg>
                            {/* Text hidden on tiny screens to prevent wrapping */}
                            <span class="hidden whitespace-nowrap uppercase tracking-wide sm:inline">Buy Me a Coffee</span>
                        </a>
                    )}
                </div>

                {/* ── Widget area ─────────────────────────────────────── */}
                <div class="relative z-10 min-h-[420px] overflow-x-auto border-b border-border/80 bg-card p-4 shadow-inner sm:p-6 md:min-h-[520px] md:p-10">
                    <WidgetRenderer slug={toolSlug} />
                </div>

                {/* ── Footer — description + CTA ──────────────────────── */}
                <div class="relative z-20 flex flex-col items-start justify-between gap-5 bg-muted/10 p-5 md:flex-row md:items-center md:px-8">

                    <div class="flex-1 max-w-2xl">
                        <h4 class="mb-1.5 text-sm font-bold text-foreground">About this tool</h4>
                        <p class="text-sm leading-relaxed text-muted-foreground text-balance">{description}</p>
                    </div>

                    {/* Standard Shadcn primary button */}
                    <a
                        href={`/tools/${toolSlug}`}
                        class="group/btn relative inline-flex h-11 w-full shrink-0 items-center justify-center overflow-hidden whitespace-nowrap rounded-md bg-primary px-8 text-sm font-semibold text-primary-foreground shadow transition-all hover:bg-primary/90 focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring disabled:pointer-events-none disabled:opacity-50 sm:w-auto"
                    >
                        <span class="relative z-10">Know more</span>
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2.5"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            class="relative z-10 ml-2 size-4 transition-transform duration-300 group-hover/btn:translate-x-1"
                            aria-hidden="true"
                        >
                            <path d="M5 12h14"/>
                            <path d="m12 5 7 7-7 7"/>
                        </svg>
                        {/* Shimmer gloss on hover */}
                        <div class="absolute inset-0 -translate-x-full bg-gradient-to-r from-transparent via-white/10 to-transparent group-hover/btn:animate-[shimmer_1.5s_infinite]" aria-hidden="true"></div>
                    </a>
                </div>

            </div>
        </div>
    </section>
)}
