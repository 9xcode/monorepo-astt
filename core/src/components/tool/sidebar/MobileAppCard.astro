---
import { Smartphone } from '@lucide/svelte';
import { siteConfig } from 'virtual:site-config';
---

<div class="relative overflow-hidden rounded-xl border border-border/60 p-6 bg-gradient-to-b from-primary/10 to-transparent shadow-sm">
	<div class="absolute -right-4 -top-4 size-24 bg-primary/20 blur-2xl rounded-full pointer-events-none"></div>
	<div class="relative z-10 space-y-4">
		<div class="size-10 rounded-xl bg-primary text-primary-foreground flex items-center justify-center shadow-md">
			<Smartphone class="size-5" />
		</div>
		<div>
			<h3 class="font-bold text-lg tracking-tight mb-1 text-foreground">Mobile App</h3>
			<p class="text-sm text-muted-foreground leading-relaxed">{siteConfig.content.components.mobileAppCard.description}</p>
		</div>
		<a href="/mobile-app" class="inline-flex w-full items-center justify-center rounded-xl bg-background border border-border/60 px-4 py-2.5 text-sm font-semibold text-foreground shadow-sm hover:bg-muted transition-colors mt-2">
			Download Now
		</a>
	</div>
</div>
