---
/**
 * AuthorAvatar — Tiny reusable avatar primitive.
 *
 * Renders a single circular avatar image using Astro's <Image> component
 * for build-time optimisation (resize, format conversion, content-hashing).
 *
 * Three sizes:
 *   sm → 32px  (inline bylines, compact lists)
 *   md → 48px  (default, blog cards, small cards)
 *   lg → 80px  (AuthorCard, profile hero)
 *
 * Usage:
 *   <AuthorAvatar author={author} />
 *   <AuthorAvatar author={author} size="lg" />
 *   <AuthorAvatar author={author} size="sm" class="ring-2 ring-primary" />
 */
import { Image } from 'astro:assets';
import type { AuthorEntry } from '../../utils/authors';

interface Props {
  author: AuthorEntry;
  /** Visual size of the avatar. Defaults to 'md'. */
  size?: 'sm' | 'md' | 'lg';
  /** Additional CSS classes — applied to the avatar wrapper div */
  class?: string;
}

const { author, size = 'md', class: className } = Astro.props;

const sizeMap = {
  sm: { px: 32,  cls: 'size-8' },
  md: { px: 48,  cls: 'size-12' },
  lg: { px: 80,  cls: 'size-20' },
} as const;

const { px, cls } = sizeMap[size];
const alt = author.data.avatarAlt ?? `${author.data.name} — ${author.data.role}`;
---

<div class:list={[cls, 'rounded-full overflow-hidden border-2 border-background shadow-sm bg-muted shrink-0', className]}>
  <Image
    src={author.data.avatar}
    alt={alt}
    width={px}
    height={px}
    class="w-full h-full object-cover"
    loading="lazy"
    decoding="async"
  />
</div>
