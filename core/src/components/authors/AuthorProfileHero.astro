---
/**
 * AuthorProfileHero — Hero section for the /authors/[slug] profile page.
 *
 * Renders: large avatar, name, role, social icon links, expertise tag badges.
 * Extracted from the page for reusability and clean separation of concerns.
 *
 * Usage (in pages/authors/[author].astro):
 *   <AuthorProfileHero author={author} />
 */
import type { AuthorEntry } from '../../utils/authors';
import AuthorAvatar from './AuthorAvatar.astro';
import AuthorSocialLinks from './AuthorSocialLinks.astro';

interface Props {
  author: AuthorEntry;
}

const { author } = Astro.props;
const { name, role, shortBio, knowsAbout, socials } = author.data;
---

<div class="flex flex-col sm:flex-row items-center sm:items-start gap-6 sm:gap-8 py-8">

  {/* Large avatar */}
  <AuthorAvatar author={author} size="lg" class="ring-4 ring-primary/10 shrink-0" />

  {/* Name, role, bio, socials, tags */}
  <div class="flex-1 text-center sm:text-left">
    <h1 class="text-3xl md:text-4xl font-extrabold tracking-tight text-foreground">{name}</h1>
    <p class="text-base text-muted-foreground mt-1 mb-3">{role}</p>
    <p class="text-[15px] text-foreground/80 leading-relaxed max-w-2xl mb-4">{shortBio}</p>

    {/* Social links */}
    <AuthorSocialLinks socials={socials} name={name} size="md" class="justify-center sm:justify-start mb-5" />

    {/* Expertise tag badges */}
    {knowsAbout && knowsAbout.length > 0 && (
      <div class="flex flex-wrap justify-center sm:justify-start gap-2">
        {knowsAbout.map(topic => (
          <span class="inline-flex items-center rounded-full bg-primary/10 text-primary px-3 py-1 text-xs font-medium">
            {topic}
          </span>
        ))}
      </div>
    )}
  </div>
</div>
