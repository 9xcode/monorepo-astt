---
/**
 * AuthorByline — Inline "By {Author}" byline for blog post and tool headers.
 *
 * Accepts one or more authors. When multiple authors are provided, names are
 * joined in natural language: "Alice", "Alice & Bob", "Alice, Bob & Carol".
 * Each name optionally links to their individual profile page.
 *
 * Usage:
 *   <AuthorByline authors={authors} />
 *   <AuthorByline authors={authors} showAvatar linkToProfile />
 *   <AuthorByline authors={authors} showAvatar={false} linkToProfile={false} />
 */
import type { AuthorEntry } from '../../utils/authors';
import { getAuthorUrl } from '../../utils/authors';
import AuthorAvatar from './AuthorAvatar.astro';

interface Props {
  authors: AuthorEntry[];
  /** Show the small avatar icon next to the first author's name. Default: false. */
  showAvatar?: boolean;
  /** Link each author name to their profile page. Default: true. */
  linkToProfile?: boolean;
}

const { authors, showAvatar = false, linkToProfile = true } = Astro.props;

// resolveAuthors() always returns at least one entry, but guard defensively
// against an empty array to avoid rendering a broken byline
if (authors.length === 0) return;

const lastIndex = authors.length - 1;
---

<span class="inline-flex items-center gap-1 flex-wrap">
  {authors.map((author, index) => {
    const profileUrl = getAuthorUrl(author.id);
    // Separator logic:
    //   - Only the first author shows the avatar (if enabled)
    //   - Between authors: ", " except before the last which gets " & "
    //   - Single author: no separator at all
    const separator =
      index === 0
        ? null                                          // first — no leading separator
        : index === lastIndex && lastIndex === 1
          ? '\u00a0&\u00a0'                            // exactly 2 authors → " & "
          : index === lastIndex
            ? ',\u00a0&\u00a0'                         // 3+ authors, last → ", & "
            : ',\u00a0';                               // middle → ", "
    return (
      <>
        {separator && (
          <span class="text-muted-foreground select-none" aria-hidden="true">{separator}</span>
        )}
        <span class="inline-flex items-center gap-1.5">
          
          {/* Avatar: only shown next to the first author to keep the byline compact.
               To show an avatar next to every author instead, remove the `index === 0 &&` condition. */}
          {index === 0 && showAvatar && (
            <AuthorAvatar author={author} size="sm" />
          )}
          {linkToProfile ? (
            <a
              href={profileUrl}
              class="font-medium text-foreground hover:text-primary transition-colors"
              rel="author"
            >
              {author.data.name}
            </a>
          ) : (
            <span class="font-medium text-foreground">{author.data.name}</span>
          )}
        </span>
      </>
    );
  })}
</span>
