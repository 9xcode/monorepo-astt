---
import { siteConfig } from 'virtual:site-config';
import type { NavItem } from '../../../config/types.ts';
type ChildNavItem = Omit<NavItem, 'children'>;

import SearchTrigger from "../search/SearchTrigger.astro";
import ThemeToggle from "../ui/ThemeToggle.svelte";
import MobileMenu from "./MobileMenu.svelte";
import Logo from "../ui/Logo.svelte";
import ErrorBoundary from "../ui/ErrorBoundary.svelte";
import { ChevronDown } from "@lucide/svelte";
---

<header class="sticky top-0 z-50 w-full bg-background/80 backdrop-blur-md supports-[backdrop-filter]:bg-background/60 transition-colors duration-300">
	<div class="container mx-auto px-4 sm:px-6 lg:px-8">
		<div class="flex h-14 items-center justify-between gap-2 sm:gap-4">
			
			{/* Left Side: Logo & Desktop Nav */}
			<div class="flex items-center gap-3 sm:gap-6 md:gap-8 flex-none">
				<a href="/" class="group flex items-center space-x-2.5 outline-none">
					<div id="header-brand-logo" class="hidden sm:flex items-center justify-center transition-all duration-[800ms] ease-[cubic-bezier(0.34,1.25,0.64,1)] group-hover:rotate-180 group-hover:scale-110 group-hover:-translate-y-0.5 group-hover:duration-300 group-hover:ease-out">
						<Logo class="size-6 text-foreground group-hover:text-primary transition-colors duration-300" />
					</div>
					<span class="font-bold text-lg tracking-tight inline-block text-foreground">
						{siteConfig.brand.shortName}
					</span>
				</a>
				<nav class="hidden md:flex items-center space-x-6 text-sm font-medium">
					{siteConfig.ui.navigation.header.map((item: NavItem) =>
						item.children && item.children.length > 0 ? (
							<div class="group relative">
								<a
									href={item.href}
									class="flex items-center gap-1 transition-colors hover:text-primary text-foreground/70"
								>
									{item.label}
									<ChevronDown class="size-3.5 transition-transform duration-200 group-hover:rotate-180" />
								</a>
								<div class="absolute top-full left-1/2 -translate-x-1/2 pt-2 hidden group-hover:block">
									<div class="w-44 rounded-xl border border-border/10 bg-background/90 backdrop-blur-xl shadow-xl py-1 overflow-hidden ring-1 ring-black/5 dark:ring-white/10">
										{item.children!.map((child: ChildNavItem) => (
											<a
												href={child.href}
												class="flex items-center px-4 py-2.5 text-sm text-muted-foreground hover:text-foreground hover:bg-muted/40 transition-colors"
											>
												{child.label}
											</a>
										))}
									</div>
								</div>
							</div>
						) : (
							<a href={item.href} class="transition-colors hover:text-primary text-foreground/70">{item.label}</a>
						)
					)}
				</nav>
			</div>

			{/* Right Side: Search, Theme Toggle & Hamburger */}
			<div class="flex flex-1 items-center justify-end gap-2 sm:gap-4">
				<div class="flex-1 flex justify-end max-w-[200px] sm:max-w-sm md:max-w-md w-full">
					<SearchTrigger triggerMode="input" class="flex h-9 w-full rounded-full bg-muted/30 hover:bg-muted/50 border border-transparent hover:border-border/40 transition-all duration-300" />
				</div>

				<div class="flex items-center flex-none">
					<ErrorBoundary client:load>
						<ThemeToggle client:idle />
					</ErrorBoundary>
				</div>

				{/* Hamburger — right side for thumb reachability on mobile */}
				<div class="md:hidden flex items-center flex-none">
					<ErrorBoundary client:load>
						<MobileMenu client:media="(max-width: 767px)" />
					</ErrorBoundary>
				</div>
			</div>
			
		</div>
	</div>
</header>
