---
/**
 * CategoryHeroSection — Shared hero section for category pages.
 * Grid-background + glow + centered badge + title + subtitle pattern.
 * Used by both categories/index.astro and categories/[category].astro.
 */

interface Props {
	badge: string;
	title: string;
	subtitle: string;
}

const { badge, title, subtitle } = Astro.props;
---

<section class="relative py-16 md:py-20 px-4 text-center overflow-hidden">
    {/* Subtle Grid Background */}
    <div class="absolute inset-0 -z-20 h-full w-full grid-bg grid-mask-category-top"></div>
    {/* Glow */}
    <div class="absolute top-0 left-1/2 w-full -translate-x-1/2 -z-10 h-48 bg-gradient-to-b from-primary/10 to-transparent blur-[80px] pointer-events-none [mask-image:linear-gradient(to_bottom,black_20%,transparent_100%)]"></div>

    <div class="container mx-auto max-w-3xl flex flex-col items-center relative z-10 antialiased">
        <span class="inline-flex items-center rounded-full border border-border/50 bg-muted/30 px-3 py-1 text-[10px] md:text-xs font-medium text-muted-foreground mb-6 uppercase tracking-widest shadow-sm">
            {badge}
        </span>
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-extrabold tracking-tight text-foreground mb-4 drop-shadow-sm">
            {title}
        </h1>
        <p class="text-base md:text-lg text-muted-foreground max-w-2xl mx-auto leading-relaxed">
            {subtitle}
        </p>
    </div>
</section>
