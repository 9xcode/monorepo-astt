---
/**
 * JsonLd — Generic JSON-LD structured data renderer.
 *
 * Accepts any schema object and renders it as a <script type="application/ld+json"> tag.
 * This is the single rendering primitive for all SEO schemas across the site.
 *
 * Usage:
 *   <JsonLd schema={mySchemaObject} />
 */
interface Props {
	schema: Record<string, unknown>;
}

const { schema } = Astro.props;
---

<script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
