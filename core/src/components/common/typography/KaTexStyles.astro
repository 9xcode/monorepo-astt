---
/**
 * KaTexStyles — Single source of truth for KaTeX CSS loading.
 *
 * Used by both ToolLayout and BlogLayout whenever hasMath is true.
 * Uses the non-blocking media="print" technique: the browser fetches the
 * stylesheet at low priority (print media), then onload upgrades it to "all",
 * activating math rendering without blocking the initial render paint.
 * The <noscript> fallback ensures math still renders when JS is disabled.
 *
 * SRI integrity attribute is included to protect against CDN compromise.
 */
---
<link
  rel="stylesheet"
  href="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.css"
  integrity="sha384-nB0miv6/jRmo5UMMR1wu3Gz6NLsoTkbqJghGIsx//Rlm+ZU03BU6SQNC66uf4l5+"
  crossorigin="anonymous"
  media="print"
  onload="this.setAttribute('media', 'all');"
/>
<noscript>
  <link
    rel="stylesheet"
    href="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.css"
    integrity="sha384-nB0miv6/jRmo5UMMR1wu3Gz6NLsoTkbqJghGIsx//Rlm+ZU03BU6SQNC66uf4l5+"
    crossorigin="anonymous"
  />
</noscript>
