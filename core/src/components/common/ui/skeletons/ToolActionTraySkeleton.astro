---
/**
 * ToolActionTraySkeleton.astro
 *
 * Server-side rendered fallback for ToolActionTray (client:only="svelte").
 * Shown via slot="fallback" on tool pages.
 *
 * Matches the 5-button pill row in ToolActionTray.svelte.
 * On mobile (<480px) the tray shows circle icon-only buttons — we keep
 * the same pill shape since the fallback is only shown briefly.
 */
---

<div class="flex flex-wrap gap-2 my-6" aria-hidden="true" aria-label="Loading tool actions...">
  {Array(5).fill(0).map(() => (
    <div class="sk h-8 w-20 rounded-md"></div>
  ))}
</div>
