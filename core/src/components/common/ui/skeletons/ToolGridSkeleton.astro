---
/**
 * ToolGridSkeleton.astro
 *
 * Server-side rendered fallback for FilterableToolGrid (client:visible).
 * Used via slot="fallback". Matches the grid's exact layout classes.
 *
 * Card count is read from siteConfig at build time — no magic numbers.
 * Falls back to 8 if the config is set to 0 (show-all mode).
 */
import { siteConfig } from 'virtual:site-config';
const rawCount = siteConfig.features.homepage.toolsDiscovery.initialDisplayCount;
// Show-all (0) → use 8 as a reasonable skeleton count (avoids huge DOM)
const count = rawCount > 0 ? rawCount : 8;
---

<div class="flex flex-col gap-6" aria-hidden="true" aria-label="Loading tools...">

  {/* Category filter chips — mirrors CategoryFilter's pill row */}
  <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-4">
    <div class="space-y-1 shrink-0">
      <div class="sk h-8 w-40 rounded-md"></div>
      <div class="sk h-4 w-56 rounded-md"></div>
    </div>
    <div class="flex gap-2 flex-wrap lg:max-w-[65%]">
      {Array(7).fill(0).map(() => (
        <div class="sk h-8 w-20 rounded-full"></div>
      ))}
    </div>
  </div>

  {/* Tool card grid — exact same classes as FilterableToolGrid's grid div */}
  <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-3 sm:gap-6">
    {Array(count).fill(0).map(() => (
      <div class="rounded-xl border border-border/40 bg-card p-4 space-y-3">
        <div class="sk h-10 w-10 rounded-lg"></div>
        <div class="sk h-4 w-3/4 rounded-md"></div>
        <div class="sk h-3 w-full rounded-md"></div>
        <div class="sk h-3 w-2/3 rounded-md"></div>
      </div>
    ))}
  </div>

</div>
