---
/**
 * WorkspaceSkeleton.astro
 *
 * Server-side rendered fallback for UserWorkspace (client:only="svelte").
 * Shown via slot="fallback" until Svelte hydrates and reads localStorage.
 *
 * Matches UserWorkspace's section wrapper, heading, and chip grid layout.
 * Note: The workspace section only renders if the user has recents/favourites.
 * The skeleton uses opacity-0 so it takes space but stays invisible — this
 * prevents CLS if the user has no saved tools (component renders nothing).
 * If the user DOES have saved tools, it smoothly fades to real content.
 */
---

<section class="pt-8 pb-16" aria-hidden="true" aria-label="Loading workspace...">
  <div class="container mx-auto px-4 space-y-6 relative z-10 w-full">

    {/* Section heading */}
    <div class="space-y-1.5 text-center lg:text-left">
      <div class="sk h-9 w-44 rounded-md mx-auto lg:mx-0"></div>
      <div class="sk h-4 w-64 rounded-md mx-auto lg:mx-0"></div>
    </div>

    {/* Tool chips grid — matches the "Recently Used" or "Saved" chip layout */}
    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 xl:grid-cols-6 gap-2 sm:gap-3">
      {Array(6).fill(0).map(() => (
        <div class="sk h-10 rounded-xl"></div>
      ))}
    </div>

  </div>
</section>
