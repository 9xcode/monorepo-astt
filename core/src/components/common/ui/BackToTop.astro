---
/**
 * NOT IN USE NOW BUT KEEP IT - NOW USING FloatingActionDock.astro
 * BackToTop — Floating back-to-top button with scroll-triggered visibility.
 */
import { ChevronUp } from '@lucide/svelte';
---

<button
	onclick="window.scrollTo({ top: 0, behavior: 'smooth' })"
	class="fixed bottom-6 right-6 z-40 size-10 rounded-full bg-primary text-primary-foreground shadow-lg hover:bg-primary/90 transition-all duration-300 flex items-center justify-center opacity-0 translate-y-4 pointer-events-none"
	id="back-to-top"
	aria-label="Back to top"
>
	<ChevronUp class="size-5" aria-hidden="true" />
</button>

<script>
	// Vite will minify, bundle, and defer this automatically (no is:inline).
	let ticking = false;
	let btn: HTMLElement | null = null;
	let isFooterVisible = false;
	let footerObserver: IntersectionObserver | null = null;

	function handleScroll() {
		if (!ticking && btn) {
			window.requestAnimationFrame(() => {
				if (window.scrollY > 800 && !isFooterVisible) {
					btn!.classList.remove('opacity-0', 'translate-y-4', 'pointer-events-none');
					btn!.classList.add('opacity-100', 'translate-y-0', 'pointer-events-auto');
				} else {
					btn!.classList.remove('opacity-100', 'translate-y-0', 'pointer-events-auto');
					btn!.classList.add('opacity-0', 'translate-y-4', 'pointer-events-none');
				}
				ticking = false;
			});
			ticking = true;
		}
	}

	function setup() {
		btn = document.getElementById('back-to-top');
		if (btn) {
			window.addEventListener('scroll', handleScroll, { passive: true });
			
			const footer = document.querySelector('footer');
			if (footer) {
				footerObserver = new IntersectionObserver((entries) => {
					isFooterVisible = entries[0]?.isIntersecting ?? false;
					handleScroll();
				}, { rootMargin: '0px' });
				footerObserver.observe(footer);
			} else {
				handleScroll();
			}
		}
	}

	function teardown() {
		window.removeEventListener('scroll', handleScroll);
		if (footerObserver) {
			footerObserver.disconnect();
			footerObserver = null;
		}
		btn = null;
	}

	document.addEventListener('astro:page-load', setup);
	document.addEventListener('astro:before-preparation', teardown);

	// Fallback for non-View-Transitions initial load
	if (document.readyState !== 'loading') {
		setup();
	} else {
		document.addEventListener('DOMContentLoaded', setup);
	}
</script>
