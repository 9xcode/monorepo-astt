---
import { Share2 } from '@lucide/svelte';
---
<button
  class="dock-action-btn group"
  aria-label="Share this page"
  onclick="window.dispatchEvent(new CustomEvent('open-share'))"
>
  <span class="dock-label whitespace-nowrap text-sm font-medium">
    Share this
  </span>
  <span class="dock-icon-wrap">
    <Share2 class="size-[1.125rem]" aria-hidden="true" />
  </span>
</button>
