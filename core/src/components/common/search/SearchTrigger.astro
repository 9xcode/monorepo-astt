---
/**
 * SearchTrigger.astro — Zero-JS trigger button for the global SearchDialog.
 *
 * Renders as pure static HTML (no client hydration). Dispatches
 * a CustomEvent that the global SearchDialog shell picks up.
 *
 * triggerMode="icon"  → compact icon button (e.g. toolbars)
 * triggerMode="input" → fake search-bar with ⌘K badge (e.g. header)
 */
import { cn } from "$lib/utils";
import { Search } from '@lucide/svelte';

interface Props {
  triggerMode?: "icon" | "input";
  class?: string;
}

const { triggerMode = "icon", class: className = "" } = Astro.props;
---

{triggerMode === "icon" ? (
  <button
    class={cn(
      "inline-flex items-center justify-center rounded-md font-medium transition-colors focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring disabled:pointer-events-none disabled:opacity-50 hover:bg-accent hover:text-accent-foreground h-9 w-9",
      className
    )}
    onclick="window.dispatchEvent(new CustomEvent('open-search'))"
    aria-label="Search tools"
  >
    <Search class="h-4 w-4" />
  </button>
) : (
  <button
    class={cn(
      "relative w-full flex items-center justify-start border border-input bg-background/50 backdrop-blur-sm px-4 py-2 rounded-xl text-sm text-muted-foreground shadow-sm hover:bg-accent hover:text-accent-foreground transition-all",
      className
    )}
    onclick="window.dispatchEvent(new CustomEvent('open-search'))"
    aria-label="Search all tools"
  >
    <Search class="mr-2 h-4 w-4 opacity-70" />
    <span class="inline-flex sm:hidden text-inherit">Search...</span>
    <span class="hidden sm:inline-flex text-inherit">Search tools...</span>
    <kbd
      class="pointer-events-none absolute right-2 top-1/2 -translate-y-1/2 hidden h-5 select-none items-center rounded border bg-muted/80 px-2 font-mono text-[10px] font-medium opacity-100 lg:flex text-muted-foreground shadow-sm"
    >
      /
    </kbd>
  </button>
)}
