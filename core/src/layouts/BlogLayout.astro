---
/**
 * BlogLayout — Layout wrapper for individual blog post pages.
 *
 * Composes: BaseLayout, Header, Footer, BlogHero, BlogSidebar,
 * RelatedPosts, BlogPageSchemas, RichArticleProse.
 *
 * Architecture mirrors ToolLayout but is simpler:
 * - No widget zone
 * - No action tray
 * - Article + sidebar 2-col grid
 * - RelatedPosts below content (not in sidebar)
 */
import BaseLayout from './BaseLayout.astro';
import Header from '../components/common/sections/Header.astro';
import Footer from '../components/common/sections/Footer.astro';
import BlogHero from '../components/blog/sections/BlogHero.astro';
import BlogSidebar from '../components/blog/sidebar/BlogSidebar.astro';
import RelatedPosts from '../components/blog/sections/RelatedPosts.astro';
import BlogPageSchemas from '../seo/BlogPageSchemas.astro';
import KaTexStyles from '../components/common/typography/KaTexStyles.astro';
import ArticleSection from '../components/common/sections/ArticleSection.astro';
import RichArticleProse from '../components/common/typography/RichArticleProse.astro';
import AuthorCard from '../components/authors/AuthorCard.astro';
import { siteConfig } from 'virtual:site-config';
import { getContentDates } from '../integrations/content-dates/resolver.ts';
import { getStaticOgImage } from '@mtools/core/utils/og';
import { replaceSeoPlaceholders, buildBlogTitle } from '../utils/seo';
import { filterTocHeadings } from '../utils/content';
import { categoryToSlug } from '@mtools/core/utils/slug';
import type { BlogPost } from '../utils/blog';
import { getBlogSlug } from '../utils/blog';
import { resolveAuthors } from '../utils/authors';
import type { MarkdownHeading } from 'astro';

interface Props {
  post: BlogPost;
  headings: MarkdownHeading[];
  readTime: number;
}

const { post, headings, readTime } = Astro.props;
const { title, seoTitle, description, coverImage, coverImageAlt, canonical, noindex, hasMath, category } = post.data;
const slug = getBlogSlug(post);

// Resolve all authors — primary + co-authors. Falls back to defaultAuthorSlug for primary.
// authors[0] is always the primary author used for SEO Person schema.
const authors = await resolveAuthors(post.data.author, post.data.coAuthors);

// Apply evergreen SEO placeholder replacement — identical to ToolLayout behaviour.
// Replaces [month], [year], [month_year] with build-time values in both fields.
const processedSeoTitle  = replaceSeoPlaceholders(seoTitle);
const processedDesc      = replaceSeoPlaceholders(description);

// categorySlug — use shared util so it matches tool category slug generation exactly.
const categorySlug = categoryToSlug(category);

// Canonical URL — uses frontmatter override if set, otherwise auto-resolves from slug.
const seoUrl = canonical
  ? new URL(canonical, siteConfig.url).href
  : new URL(`/blog/${slug}`, siteConfig.url).href;

// OG Image — from manifest (with cache-busting hash) or fallback.
const ogImagePath = getStaticOgImage('blog', slug);
const fullOgImageUrl = ogImagePath
  ? new URL(ogImagePath, siteConfig.url).href
  : new URL('/images/og-image.png', siteConfig.url).href;

// Pre-resolve dates from the content-dates integration.
// Fallback hierarchy: frontmatter publishedAt/updatedAt → git → publishedAt.
const { publishedAt, updatedAt } = getContentDates('blog', slug);

// TOC: post.data.toc overrides site global. filterTocHeadings handles all
// depth/threshold logic — same function as [tool].astro uses.
const tocHeadings = filterTocHeadings(headings, post.data.toc);
---

<BaseLayout
  title={buildBlogTitle(title, processedSeoTitle)}
  description={processedDesc}
  canonicalURL={seoUrl}
  image={ogImagePath}
  type="article"
>
  <Fragment slot="head">
    {/*
      BlogPageSchemas composes:
        1. Article JSON-LD (author resolved from Content Collection via resolveAuthors)
        2. BreadcrumbList JSON-LD (4-level: Home → Blog → Category → Post)
        3. Optional FAQPage JSON-LD
      authors[0] is the primary author for the Person schema.
    */}
    <BlogPageSchemas
      postTitle={title}
      description={processedDesc}
      seoUrl={seoUrl}
      ogImageUrl={fullOgImageUrl}
      publishedAt={publishedAt}
      updatedAt={updatedAt}
      tocHeadings={tocHeadings}
      category={category}
      categorySlug={categorySlug}
      author={authors[0]}
    />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {hasMath && <KaTexStyles />}
  </Fragment>

  <Header />
  <main class="flex-1 container mx-auto px-4 py-8">
    <div class="grid grid-cols-1 lg:grid-cols-[1fr_320px] lg:gap-12">
      <div class="space-y-6">
        <article>
          <BlogHero
            {title}
            updatedAt={updatedAt}
            authors={authors}
            {coverImage}
            {coverImageAlt}
            {readTime}
            {category}
            {categorySlug}
          />

          <ArticleSection tocHeadings={tocHeadings} tags={post.data.tags} category={category}>
            <RichArticleProse>
              <slot />
            </RichArticleProse>
          </ArticleSection>

          <AuthorCard authors={authors} />
        </article>

        <RelatedPosts currentPost={post} />
      </div>

      <BlogSidebar />
    </div>
  </main>
  <Footer />
</BaseLayout>
