# build output
dist/

# generated types
.astro/

# ignore auto generated graphify output files
graphify-out/

# OG Image Caches
/public/images/og/**/*.png
# NOTE: .og-manifest.json is NOT ignored. Track it in Git to show OG updates in pull requests!

# auto-generated files (rebuilt on every dev/build)
src/generated/

# dependencies
node_modules/

# file for temporary use
tmp-file.md


# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# environment variables
# Commit .env only if it has non-sensitive defaults (e.g., SITE_URL)
# Use .env.local for secrets — it is always gitignored
.env
.env.local
.env.*.local
.env.development.local
.env.test.local
.env.production.local

# TypeScript incremental build cache
*.tsbuildinfo

# macOS-specific files
.DS_Store

# Editor settings
.idea/
# Uncomment below if you don't want to share VS Code settings with the team:
.vscode/
