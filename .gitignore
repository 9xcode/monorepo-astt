# build output
dist/
**/dist/

# generated types
.astro/
**/.astro/

# Turborepo cache
.turbo/

# ignore auto generated graphify output files
graphify-out/

# angigravity
.antigravitycli/
.agents/

# OG Image Caches
/public/images/og/**/*.png
sites/*/public/images/og/**/*.png
# NOTE: .og-manifest.json is NOT ignored. Track it in Git to show OG updates in pull requests!

# auto-generated files (rebuilt on every dev/build)
src/generated/
sites/*/src/generated/

# dependencies
node_modules/
**/node_modules/
# pnpm parks packages installed by other package managers here
node_modules/.ignored/

# file for temporary use
tmp.md
docs/tmp.md

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# environment variables
# Commit .env only if it has non-sensitive defaults (e.g., SITE_URL)
# Use .env.local for secrets — it is always gitignored
.env
.env.local
.env.*.local
.env.development.local
.env.test.local
.env.production.local

# TypeScript incremental build cache
*.tsbuildinfo

# macOS-specific files
.DS_Store

# Editor settings
.idea/
# Uncomment below if you don't want to share VS Code settings with the team:
.vscode/

# Capacitor native platform projects
mobile/*/android/
mobile/*/ios/
