# pnpm monorepo configuration

# Hoist packages to root node_modules so that Turborepo and Astro
# tooling (eslint, astro check, etc.) can resolve shared devDependencies
# without each site needing to redeclare them.
hoist=true

# Use a single shared lockfile for the entire workspace (default: true)
shared-workspace-lockfile=true

# Automatically install peer dependencies (pnpm v8+ default, explicit here)
auto-install-peers=true
